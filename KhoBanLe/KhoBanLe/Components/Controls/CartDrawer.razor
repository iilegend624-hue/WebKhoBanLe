@namespace KhoBanLe.Components.Controls
@inject ShoppingCartService CartService
@inject NavigationManager Nav
@implements IDisposable

@if (CartService.IsDrawerOpen)
{
    <!-- Backdrop mờ phía sau -->
    <div class="cart-drawer-backdrop" @onclick="CartService.CloseDrawer"></div>

    <!-- Ngăn kéo trượt từ phải sang -->
    <div class="cart-drawer shadow-2xl">
        <!-- Drawer Header -->
        <div class="cart-drawer-header d-flex align-items-center justify-content-between p-3 border-bottom bg-white sticky-top">
            <div class="d-flex align-items-center gap-2">
                <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-2 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                    <i class="bi bi-cart3 fs-5"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-0 text-dark">Giỏ Hàng & Quầy Thu Ngân (POS)</h6>
                    <small class="text-muted">Đang có <strong class="text-primary">@CartService.TotalItems</strong> sản phẩm trong giỏ</small>
                </div>
            </div>
            <button type="button" class="btn btn-sm btn-light border rounded-circle p-1" style="width: 32px; height: 32px;" @onclick="CartService.CloseDrawer" title="Đóng giỏ hàng">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <!-- Alert thông báo nội bộ -->
        @if (!string.IsNullOrEmpty(alertMsg))
        {
            <div class="p-3 pb-0">
                <div class="alert @(isSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show rounded-3 p-2.5 small mb-0" role="alert">
                    <i class="bi @(isSuccess ? "bi-check-circle-fill text-success" : "bi-exclamation-triangle-fill text-danger") me-1"></i>
                    @alertMsg
                    <button type="button" class="btn-close py-2.5" @onclick="() => alertMsg = null"></button>
                </div>
            </div>
        }

        <!-- Drawer Body -->
        <div class="cart-drawer-body p-3 overflow-y-auto flex-grow-1">
            @if (CartService.Items.Any())
            {
                <div class="d-flex flex-column gap-2.5">
                    @foreach (var item in CartService.Items)
                    {
                        <div class="cart-item-card p-2.5 rounded-3 border bg-white shadow-xs">
                            <div class="d-flex gap-2.5 align-items-center">
                                <!-- Thumbnail -->
                                <div class="rounded-2 overflow-hidden border flex-shrink-0" style="width: 58px; height: 58px; background: #f8fafc;">
                                    <img src="@(string.IsNullOrEmpty(item.Product?.ImageUrl) ? "favicon.png" : item.Product.ImageUrl)" 
                                         alt="@item.Product?.Name" 
                                         class="w-100 h-100 object-fit-cover" 
                                         onerror="this.src='favicon.png'" />
                                </div>

                                <!-- Info -->
                                <div class="flex-grow-1 min-w-0">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div class="fw-bold text-dark text-truncate small" title="@item.Product?.Name">
                                            @(item.Product?.Name ?? "Sản phẩm")
                                        </div>
                                        <button class="btn btn-sm text-danger p-0 ms-1" title="Xóa khỏi giỏ" @onclick="() => CartService.RemoveFromCart(item.ProductId)">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </div>
                                    <div class="text-muted small" style="font-size: 0.75rem;">
                                        Mã: @(item.Product?.Sku ?? "") &bull; ĐVT: @(item.Product?.Unit ?? "")
                                    </div>
                                    
                                    <div class="d-flex justify-content-between align-items-center mt-1.5">
                                        <!-- Price -->
                                        <div class="fw-bold text-primary small">
                                            @((item.UnitPrice).ToString("N0")) đ
                                        </div>

                                        <!-- Stepper -->
                                        <div class="input-group input-group-sm" style="width: 95px;">
                                            <button class="btn btn-outline-secondary py-0 px-2" type="button" @onclick="() => UpdateItemQty(item.ProductId, item.Quantity - 1)">-</button>
                                            <span class="form-control text-center py-0 px-1 fw-bold bg-white small" style="height: 26px; line-height: 24px;">@item.Quantity</span>
                                            <button class="btn btn-outline-secondary py-0 px-2" type="button" @onclick="() => UpdateItemQty(item.ProductId, item.Quantity + 1)">+</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Quick POS Cashier Section -->
                <div class="mt-3 p-3 rounded-3 bg-light border">
                    <div class="fw-bold text-dark small mb-2">
                        <i class="bi bi-person-fill text-primary me-1"></i>Thông tin thu ngân & Khách hàng
                    </div>
                    <div class="mb-2">
                        <input type="text" class="form-control form-control-sm" placeholder="Tên khách hàng (mặc định: Khách mua lẻ)" @bind="customerName" />
                    </div>
                    <div>
                        <select class="form-select form-select-sm" @bind="paymentMethod">
                            <option value="Tiền mặt">💵 Tiền mặt</option>
                            <option value="Chuyển khoản QR">📱 Chuyển khoản VietQR</option>
                            <option value="Quẹt thẻ POS">💳 Quẹt thẻ POS</option>
                        </select>
                    </div>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <div class="rounded-circle bg-light p-4 d-inline-flex mb-3">
                        <i class="bi bi-cart-x fs-1 text-secondary"></i>
                    </div>
                    <h6 class="fw-bold text-dark mb-1">Giỏ hàng của bạn đang trống!</h6>
                    <p class="small text-muted mb-3">Chưa có sản phẩm nào được chọn.</p>
                    <button class="btn btn-sm btn-primary rounded-pill px-4 fw-semibold" @onclick="GoToProducts">
                        <i class="bi bi-boxes me-1"></i>Xem danh mục sản phẩm
                    </button>
                </div>
            }
        </div>

        <!-- Drawer Footer -->
        @if (CartService.Items.Any())
        {
            <div class="cart-drawer-footer p-3 border-top bg-white">
                <div class="d-flex justify-content-between align-items-baseline mb-2">
                    <span class="text-muted small">Tổng tiền thanh toán:</span>
                    <span class="h4 fw-bold text-success mb-0">@((CartService.TotalAmount).ToString("N0")) đ</span>
                </div>

                <div class="d-grid gap-2">
                    <button class="btn btn-success rounded-pill py-2.5 fw-bold shadow-sm d-flex align-items-center justify-content-center gap-2"
                            disabled="@isProcessing"
                            @onclick="HandleQuickCheckout">
                        @if (isProcessing)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                            <span>Đang thanh toán...</span>
                        }
                        else
                        {
                            <i class="bi bi-lightning-charge-fill"></i>
                            <span>Thanh Toán & Trừ Tồn Kho Ngay</span>
                        }
                    </button>

                    <div class="d-flex gap-2">
                        <button class="btn btn-sm btn-outline-secondary rounded-pill w-50 py-1.5 fw-medium" @onclick="GoToFullCart">
                            <i class="bi bi-receipt me-1"></i>Trang giỏ hàng
                        </button>
                        <button class="btn btn-sm btn-light border rounded-pill w-50 py-1.5 fw-medium text-danger" @onclick="CartService.ClearCart">
                            <i class="bi bi-trash3 me-1"></i>Xóa sạch giỏ
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private string customerName = "Khách mua lẻ tại quầy";
    private string paymentMethod = "Tiền mặt";
    private string? alertMsg = null;
    private bool isSuccess = false;
    private bool isProcessing = false;

    protected override void OnInitialized()
    {
        CartService.OnChange += OnCartChanged;
    }

    private async void OnCartChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    private void UpdateItemQty(int productId, int newQty)
    {
        alertMsg = null;
        var err = CartService.UpdateQuantity(productId, newQty);
        if (!string.IsNullOrEmpty(err))
        {
            alertMsg = err;
            isSuccess = false;
        }
    }

    private async Task HandleQuickCheckout()
    {
        isProcessing = true;
        alertMsg = null;

        var result = await CartService.CheckoutAsync(customerName, paymentMethod);
        isProcessing = false;

        if (result.Success)
        {
            alertMsg = $"Thanh toán thành công phiếu {result.IssueNumber}! Tổng tiền: {result.TotalAmount:N0} đ";
            isSuccess = true;
        }
        else
        {
            alertMsg = result.ErrorMessage ?? "Thanh toán thất bại!";
            isSuccess = false;
        }
    }

    private void GoToProducts()
    {
        CartService.CloseDrawer();
        Nav.NavigateTo("products");
    }

    private void GoToFullCart()
    {
        CartService.CloseDrawer();
        Nav.NavigateTo("cart");
    }

    public void Dispose()
    {
        CartService.OnChange -= OnCartChanged;
    }
}
