@namespace KhoBanLe.Components.Controls

<div class="reusable-search-bar bg-white rounded-3 shadow-xs">
    <div class="d-flex align-items-center w-100 search-input-container">
        <span class="search-icon-box text-success ps-3 pe-2">
            <i class="bi bi-search fs-6"></i>
        </span>
        <input type="text" 
               class="form-control form-control-seamless py-2 ps-1 pe-2 fw-medium" 
               placeholder="@Placeholder" 
               value="@SearchTerm" 
               @oninput="HandleInput" />
        @if (!string.IsNullOrEmpty(SearchTerm))
        {
            <button class="btn btn-link text-muted p-1 me-2 search-clear-btn" type="button" @onclick="HandleClear" title="Xóa tìm kiếm">
                <i class="bi bi-x-circle-fill fs-6 text-secondary"></i>
            </button>
        }
        @if (ShowCategoryFilter)
        {
            <div class="border-start ps-2 pe-2 py-1" style="min-width: 170px;">
                <select class="form-select form-select-sm border-0" value="@SelectedCategory" @onchange="HandleCategoryChange">
                    <option value="">-- Tất cả ngành --</option>
                    @foreach (var cat in Categories)
                    {
                        <option value="@cat">@cat</option>
                    }
                </select>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public string SearchTerm { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> SearchTermChanged { get; set; }

    [Parameter] public string SelectedCategory { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> SelectedCategoryChanged { get; set; }

    [Parameter] public bool ShowCategoryFilter { get; set; } = true;
    [Parameter] public string Placeholder { get; set; } = "Tìm kiếm theo mã SKU, tên hàng hóa...";
    [Parameter] public List<string> Categories { get; set; } = new()
    {
        "Văn phòng phẩm",
        "Thực phẩm & Gia vị",
        "Sữa & Chế phẩm sữa",
        "Nước giải khát & Bia",
        "Bánh kẹo & Đồ ăn vặt",
        "Hóa mỹ phẩm & Đồ gia dụng"
    };

    [Parameter] public EventCallback OnSearch { get; set; }
    [Parameter] public EventCallback OnClear { get; set; }

    private async Task HandleInput(ChangeEventArgs e)
    {
        SearchTerm = e.Value?.ToString() ?? string.Empty;
        await SearchTermChanged.InvokeAsync(SearchTerm);
        await OnSearch.InvokeAsync();
    }

    private async Task HandleCategoryChange(ChangeEventArgs e)
    {
        SelectedCategory = e.Value?.ToString() ?? string.Empty;
        await SelectedCategoryChanged.InvokeAsync(SelectedCategory);
        await OnSearch.InvokeAsync();
    }

    private async Task HandleClear()
    {
        SearchTerm = string.Empty;
        await SearchTermChanged.InvokeAsync(string.Empty);
        await OnClear.InvokeAsync();
    }
}
