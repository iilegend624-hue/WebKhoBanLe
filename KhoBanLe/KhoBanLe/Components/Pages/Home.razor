@page "/"
@rendermode InteractiveServer
@namespace KhoBanLe.Components.Pages
@inject ISearchProductsUseCase SearchProducts
@inject IViewGoodsReceiptUseCase ViewReceipts
@inject IViewGoodsIssueUseCase ViewIssues
@inject UserRoleService RoleService
@inject NavigationManager Nav

<PageTitle>Tổng Quan Quản Lý Kho Bán Lẻ - KhoBanLe</PageTitle>

<div class="container-fluid px-0">
    <!-- 1. EXECUTIVE WELCOME & QUICK ACTION HERO BANNER -->
    <div class="dashboard-hero-card mb-4">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="badge bg-white text-success border border-success border-opacity-25 shadow-xs px-2.5 py-1 rounded-pill fw-semibold d-inline-flex align-items-center gap-1.5 small">
                        <span class="live-pulse-dot"></span>
                        Trực Tuyến &bull; SQL Server Live
                    </span>
                    <span class="badge bg-white text-secondary border shadow-xs px-2.5 py-1 rounded-pill small">
                        Clean Architecture 4 Tầng &bull; Capstone ECO2415
                    </span>
                </div>
                <h2 class="fw-bold text-dark mb-1" style="letter-spacing: -0.025em;">
                    Tổng Quan Hoạt Động Kho Bán Lẻ
                </h2>
                <p class="text-muted mb-0" style="font-size: 0.92rem;">
                    Kiểm soát xuất – nhập – tồn kho thời gian thực, quản lý ngưỡng tồn an toàn và theo dõi luồng giao dịch chứng từ.
                </p>
            </div>

            <!-- Quick Fast Actions -->
            <div class="d-flex flex-wrap align-items-center gap-2">
                <a href="receipts/create" class="btn btn-light bg-white text-success border-0 rounded-pill fw-bold px-3 py-2 shadow-sm d-flex align-items-center gap-1.5" title="Lập phiếu nhập kho">
                    <i class="bi bi-plus-circle-fill text-success me-1"></i>Lập Phiếu Nhập
                </a>
                <a href="issues/create" class="btn btn-light bg-white text-danger border-0 rounded-pill fw-bold px-3 py-2 shadow-sm d-flex align-items-center gap-1.5" title="Lập phiếu xuất kho">
                    <i class="bi bi-dash-circle-fill text-danger me-1"></i>Lập Phiếu Xuất
                </a>
                <a href="cart" class="btn btn-warning text-dark border-0 rounded-pill fw-bold px-3 py-2 shadow-sm d-flex align-items-center gap-1.5" title="Mở quầy POS">
                    <i class="bi bi-shop me-1"></i>Quầy Bán POS
                </a>
                <a href="reports" class="btn btn-light bg-white text-primary border-0 rounded-pill fw-bold px-3 py-2 shadow-sm d-flex align-items-center gap-1.5" title="Báo cáo NXT & Xuất Excel">
                    <i class="bi bi-file-earmark-excel-fill text-success me-1"></i>Báo Cáo NXT
                </a>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="dashboard-table-card p-5 text-center my-4">
            <div class="spinner-border text-success mb-3" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Đang tải...</span>
            </div>
            <h5 class="fw-bold text-dark">Đang đồng bộ dữ liệu thời gian thực từ SQL Server...</h5>
            <p class="text-muted small mb-0">Vui lòng chờ trong giây lát.</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger rounded-4 shadow-xs mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill fs-4 text-danger"></i>
                <div>
                    <h6 class="fw-bold mb-0">Lỗi truy vấn dữ liệu từ SQL Server</h6>
                    <div>@errorMessage</div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- 2. 6 EXECUTIVE KPI STAT CARDS -->
        <div class="row g-3 mb-4">
            <!-- Card 1: Tổng SKU -->
            <div class="col-12 col-sm-6 col-xl-2">
                <a href="products" class="executive-kpi-card kpi-emerald h-100">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted fw-bold small text-uppercase" style="letter-spacing: 0.05em; font-size: 0.72rem;">Số Mặt Hàng</span>
                        <div class="kpi-icon-bubble bg-success bg-opacity-10 text-success">
                            <i class="bi bi-boxes"></i>
                        </div>
                    </div>
                    <div class="kpi-number-display">@totalProducts <span class="fs-6 fw-normal text-muted">SKU</span></div>
                    <div class="d-flex align-items-center gap-1 small text-success fw-medium">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>@activeCategories nhóm hàng</span>
                    </div>
                </a>
            </div>

            <!-- Card 2: Tổng đơn vị tồn thực tế -->
            <div class="col-12 col-sm-6 col-xl-2">
                <a href="products" class="executive-kpi-card kpi-blue h-100">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted fw-bold small text-uppercase" style="letter-spacing: 0.05em; font-size: 0.72rem;">Tổng Đơn Vị Tồn</span>
                        <div class="kpi-icon-bubble bg-primary bg-opacity-10 text-primary">
                            <i class="bi bi-layers-fill"></i>
                        </div>
                    </div>
                    <div class="kpi-number-display">@totalInventoryUnits.ToString("N0")</div>
                    <div class="d-flex align-items-center gap-1 small text-muted">
                        <i class="bi bi-info-circle text-primary"></i>
                        <span>Đơn vị lưu kho</span>
                    </div>
                </a>
            </div>

            <!-- Card 3: Cảnh báo tồn thấp -->
            <div class="col-12 col-sm-6 col-xl-2">
                <a href="products?stock=low_stock" class="executive-kpi-card kpi-amber h-100 @(lowStockCount > 0 ? "border-warning" : "")">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted fw-bold small text-uppercase" style="letter-spacing: 0.05em; font-size: 0.72rem;">Tồn Dưới Min</span>
                        <div class="kpi-icon-bubble bg-warning bg-opacity-15 text-warning-emphasis">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                        </div>
                    </div>
                    <div class="kpi-number-display @(lowStockCount > 0 ? "text-warning" : "text-dark")">
                        @lowStockCount <span class="fs-6 fw-normal text-muted">mặt hàng</span>
                    </div>
                    <div class="d-flex align-items-center gap-1 small @(lowStockCount > 0 ? "text-warning fw-semibold" : "text-success")">
                        <i class="bi @(lowStockCount > 0 ? "bi-bell-fill" : "bi-shield-check")"></i>
                        <span>@(lowStockCount > 0 ? "Cần nhập thêm" : "Đạt định mức")</span>
                    </div>
                </a>
            </div>

            <!-- Card 4: Mặt hàng hết hàng -->
            <div class="col-12 col-sm-6 col-xl-2">
                <a href="products?stock=out_of_stock" class="executive-kpi-card kpi-rose h-100 @(outOfStockCount > 0 ? "border-danger" : "")">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted fw-bold small text-uppercase" style="letter-spacing: 0.05em; font-size: 0.72rem;">Hết Hàng (Tồn = 0)</span>
                        <div class="kpi-icon-bubble bg-danger bg-opacity-10 text-danger">
                            <i class="bi bi-x-octagon-fill"></i>
                        </div>
                    </div>
                    <div class="kpi-number-display @(outOfStockCount > 0 ? "text-danger" : "text-dark")">
                        @outOfStockCount <span class="fs-6 fw-normal text-muted">mặt hàng</span>
                    </div>
                    <div class="d-flex align-items-center gap-1 small @(outOfStockCount > 0 ? "text-danger fw-semibold" : "text-success")">
                        <i class="bi bi-shield-exclamation"></i>
                        <span>@(outOfStockCount > 0 ? "Hết sạch hàng" : "Không có hàng hết")</span>
                    </div>
                </a>
            </div>

            <!-- Card 5: Chứng từ chờ duyệt -->
            <div class="col-12 col-sm-6 col-xl-2">
                <a href="approvals" class="executive-kpi-card kpi-violet h-100 @(pendingCount > 0 ? "border-primary" : "")">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted fw-bold small text-uppercase" style="letter-spacing: 0.05em; font-size: 0.72rem;">Phiếu Chờ Duyệt</span>
                        <div class="kpi-icon-bubble" style="background-color: rgba(124, 58, 237, 0.1); color: #7c3aed;">
                            <i class="bi bi-clock-history"></i>
                        </div>
                    </div>
                    <div class="kpi-number-display" style="color: #7c3aed;">@pendingCount <span class="fs-6 fw-normal text-muted">phiếu</span></div>
                    <div class="d-flex align-items-center gap-1 small fw-medium" style="color: #7c3aed;">
                        <i class="bi bi-shield-lock-fill"></i>
                        <span>@pendingReceiptsCount nhập &bull; @pendingIssuesCount xuất</span>
                    </div>
                </a>
            </div>

            <!-- Card 6: Tổng giá trị tồn kho -->
            <div class="col-12 col-sm-6 col-xl-2">
                <a href="reports" class="executive-kpi-card kpi-emerald h-100">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted fw-bold small text-uppercase" style="letter-spacing: 0.05em; font-size: 0.72rem;">Giá Trị Tồn Kho</span>
                        <div class="kpi-icon-bubble bg-success bg-opacity-10 text-success">
                            <i class="bi bi-cash-stack"></i>
                        </div>
                    </div>
                    <div class="kpi-number-display" style="font-size: 1.35rem;">@(totalStockValue.ToString("N0")) đ</div>
                    <div class="d-flex align-items-center gap-1 small text-muted">
                        <i class="bi bi-tag-fill text-success"></i>
                        <span>Theo giá niêm yết</span>
                    </div>
                </a>
            </div>
        </div>

        <!-- 3. THROUGHPUT & TRANSACTION METRICS BANNER (LUỒNG XUẤT - NHẬP KHO) -->
        <div class="row g-3 mb-4">
            <!-- Flow 1: Inbound Nhập kho -->
            <div class="col-12 col-md-6">
                <div class="flow-summary-card inbound-card h-100">
                    <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="kpi-icon-bubble bg-success text-white shadow-xs" style="width: 50px; height: 50px; font-size: 1.4rem;">
                                <i class="bi bi-box-arrow-in-down"></i>
                            </div>
                            <div>
                                <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle rounded-pill px-2 py-0.5 small fw-bold">LUỒNG NHẬP KHO</span>
                                <div class="h4 fw-bold text-dark mb-0 mt-1">
                                    @totalReceiptsCount <span class="fs-6 fw-normal text-muted">phiếu nhập</span>
                                </div>
                            </div>
                        </div>
                        <a href="receipts" class="btn btn-sm btn-outline-success rounded-pill fw-semibold px-3 d-inline-flex align-items-center gap-1 shadow-xs">
                            Sổ phiếu &rarr;
                        </a>
                    </div>
                    <div class="d-flex flex-wrap align-items-center justify-content-between pt-2 border-top gap-2 small">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-white text-dark border px-2 py-1 rounded-pill">
                                <strong>+@totalImportUnits.ToString("N0")</strong> đơn vị hàng hóa
                            </span>
                            <span class="text-muted">Đã duyệt: <strong>@totalApprovedReceiptsCount</strong></span>
                            @if (pendingReceiptsCount > 0)
                            {
                                <span class="badge bg-warning bg-opacity-20 text-warning-emphasis rounded-pill px-2 py-0.5">
                                    @pendingReceiptsCount chờ duyệt
                                </span>
                            }
                        </div>
                        <a href="receipts/create" class="text-success fw-semibold text-decoration-none">
                            + Tạo phiếu nhập mới
                        </a>
                    </div>
                </div>
            </div>

            <!-- Flow 2: Outbound Xuất kho -->
            <div class="col-12 col-md-6">
                <div class="flow-summary-card outbound-card h-100">
                    <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="kpi-icon-bubble bg-danger text-white shadow-xs" style="width: 50px; height: 50px; font-size: 1.4rem;">
                                <i class="bi bi-box-arrow-up"></i>
                            </div>
                            <div>
                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger-subtle rounded-pill px-2 py-0.5 small fw-bold">LUỒNG XUẤT KHO</span>
                                <div class="h4 fw-bold text-dark mb-0 mt-1">
                                    @totalIssuesCount <span class="fs-6 fw-normal text-muted">phiếu xuất</span>
                                </div>
                            </div>
                        </div>
                        <a href="issues" class="btn btn-sm btn-outline-danger rounded-pill fw-semibold px-3 d-inline-flex align-items-center gap-1 shadow-xs">
                            Sổ phiếu &rarr;
                        </a>
                    </div>
                    <div class="d-flex flex-wrap align-items-center justify-content-between pt-2 border-top gap-2 small">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-white text-dark border px-2 py-1 rounded-pill">
                                <strong>-@totalExportUnits.ToString("N0")</strong> đơn vị hàng hóa
                            </span>
                            <span class="text-muted">Đã duyệt: <strong>@totalApprovedIssuesCount</strong></span>
                            @if (pendingIssuesCount > 0)
                            {
                                <span class="badge bg-warning bg-opacity-20 text-warning-emphasis rounded-pill px-2 py-0.5">
                                    @pendingIssuesCount chờ duyệt
                                </span>
                            }
                        </div>
                        <a href="issues/create" class="text-danger fw-semibold text-decoration-none">
                            + Tạo phiếu xuất mới
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- 4. 2 LUẬT NGHIỆP VỤ BẢO VỆ CỐT LÕI (CLEAN ARCHITECTURE COMPLIANCE) -->
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <div class="business-rule-card h-100 border-start border-4 border-danger">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-shield-fill-check fs-4 text-danger"></i>
                            <h6 class="mb-0 fw-bold text-dark">Quy Chuẩn 1: Duyệt Mới Cập Nhật Tồn & Chặn Xuất Âm</h6>
                        </div>
                        <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-2.5 py-1 small fw-bold">K1.3 &bull; K2.2</span>
                    </div>
                    <p class="small text-muted mb-3">
                        Tồn kho <strong>CHỈ</strong> được trừ khi Quản lý duyệt phiếu trong 1 Transaction nguyên tử duy nhất.
                        Nếu tổng lượng xuất theo từng sản phẩm vượt tồn kho hiện có, hệ thống lập tức <strong>chặn lỗi thân thiện</strong>.
                    </p>
                    <div class="p-2.5 rounded-3 bg-light border small d-flex align-items-center justify-content-between">
                        <div>
                            <span class="fw-semibold text-dark">Kịch bản thử nghiệm:</span>
                            <span class="text-muted ms-1">Phiếu xuất demo PX-2026-002 xuất 10 Bút bi (Tồn 3)</span>
                        </div>
                        <a href="approvals" class="btn btn-xs btn-outline-danger rounded-pill fw-bold px-3 py-1">
                            Thử duyệt ngay &rarr;
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="business-rule-card h-100 border-start border-4 border-success">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-calculator-fill fs-4 text-success"></i>
                            <h6 class="mb-0 fw-bold text-dark">Quy Chuẩn 2: Bảo Toàn Công Thức Nhập – Xuất – Tồn</h6>
                        </div>
                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2.5 py-1 small fw-bold">K1.3 &bull; K2.3</span>
                    </div>
                    <p class="small text-muted mb-3">
                        Công thức bất biến: <strong>Tồn đầu kỳ + Tổng nhập (Approved) - Tổng xuất (Approved) = Tồn cuối kỳ</strong>.
                        Tất cả phiếu đã duyệt được bảo vệ không thể tự ý sửa đổi gây sai lệch lịch sử giao dịch.
                    </p>
                    <div class="p-2.5 rounded-3 bg-light border small d-flex align-items-center justify-content-between">
                        <div>
                            <span class="fw-semibold text-dark">Đối soát sổ cái:</span>
                            <span class="text-success ms-1"><i class="bi bi-check-circle-fill me-1"></i>Khớp dữ liệu 100%</span>
                        </div>
                        <a href="reports" class="btn btn-xs btn-outline-success rounded-pill fw-bold px-3 py-1">
                            Xem báo cáo NXT &rarr;
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- 5. REAL-TIME DATA TABLES -->
        <div class="row g-4">
            <!-- Table 1: Cảnh báo hàng sắp hết & Hết hàng -->
            <div class="col-lg-6">
                <div class="dashboard-table-card h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                        <div>
                            <h6 class="fw-bold mb-0 text-dark">
                                <i class="bi bi-exclamation-triangle-fill text-warning me-1.5"></i>Mặt Hàng Chạm Ngưỡng Tồn Tối Thiểu
                            </h6>
                            <small class="text-muted">Cần ưu tiên lập phiếu nhập từ nhà cung cấp</small>
                        </div>
                        <a href="products?stock=low_stock" class="btn btn-sm btn-light border rounded-pill px-3 py-1 text-primary fw-semibold small shadow-xs">
                            Xem tất cả &rarr;
                        </a>
                    </div>

                    <div class="table-responsive">
                        <table class="table dashboard-table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>MÃ SKU</th>
                                    <th>TÊN HÀNG HÓA</th>
                                    <th class="text-center">TỒN / MIN</th>
                                    <th class="text-end">TRẠNG THÁI</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (lowStockProducts.Any())
                                {
                                    @foreach (var p in lowStockProducts.Take(6))
                                    {
                                        <tr>
                                            <td data-label="Mã SKU">
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="rounded-3 border p-0.5 bg-white shadow-xs d-flex align-items-center justify-content-center" style="width: 38px; height: 38px; min-width: 38px;">
                                                        <img src="@GetProductImage(p.ImageUrl)" alt="@p.Name" style="max-width: 100%; max-height: 100%; object-fit: contain;" onerror="this.src='images/default-product.svg'" />
                                                    </div>
                                                    <span class="badge bg-light text-dark border fw-bold font-monospace">@p.Sku</span>
                                                </div>
                                            </td>
                                            <td data-label="Tên hàng hóa">
                                                <div class="fw-semibold text-dark text-truncate" style="max-width: 210px;" title="@p.Name">@p.Name</div>
                                                <small class="text-muted">ĐVT: @p.Unit &bull; Giá: @((p.Price).ToString("N0")) đ</small>
                                            </td>
                                            <td data-label="Tồn / Min" class="text-center fw-bold">
                                                <span class="@(p.CurrentStock == 0 ? "text-danger" : "text-warning")">
                                                    @p.CurrentStock
                                                </span>
                                                <span class="text-muted small fw-normal"> / @p.MinStockLevel</span>
                                            </td>
                                            <td data-label="Trạng thái" class="text-end">
                                                <StockStatusBadge CurrentStock="@p.CurrentStock" MinStock="@p.MinStockLevel" />
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center text-muted py-4">Tất cả hàng hóa đều đạt định mức tồn an toàn!</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Table 2: Chứng từ mới nhất -->
            <div class="col-lg-6">
                <div class="dashboard-table-card h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                        <div>
                            <h6 class="fw-bold mb-0 text-dark">
                                <i class="bi bi-journal-text text-primary me-1.5"></i>Chứng Từ Kho Mới Nhất
                            </h6>
                            <small class="text-muted">Lịch sử lập và phê duyệt phiếu gần đây</small>
                        </div>
                        <a href="approvals" class="btn btn-sm btn-light border rounded-pill px-3 py-1 text-primary fw-semibold small shadow-xs">
                            Duyệt phiếu &rarr;
                        </a>
                    </div>

                    <div class="table-responsive">
                        <table class="table dashboard-table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>MÃ PHIẾU</th>
                                    <th>LOẠI</th>
                                    <th>ĐỐI TÁC / NƠI NHẬN</th>
                                    <th class="text-end">TỔNG TIỀN</th>
                                    <th class="text-end">TRẠNG THÁI</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in recentReceipts)
                                {
                                    <tr>
                                        <td data-label="Mã phiếu">
                                            <a href="receipts" class="fw-bold text-success text-decoration-none font-monospace">@r.ReceiptNumber</a>
                                        </td>
                                        <td data-label="Loại">
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle rounded-pill px-2 py-0.5">Nhập</span>
                                        </td>
                                        <td data-label="Đối tác">
                                            <div class="text-truncate" style="max-width: 150px;">@(r.Supplier?.Name ?? "Nhà cung cấp")</div>
                                        </td>
                                        <td data-label="Tổng tiền" class="text-end fw-semibold text-success font-monospace">
                                            @((r.TotalAmount).ToString("N0")) đ
                                        </td>
                                        <td data-label="Trạng thái" class="text-end">
                                            <ReceiptStatusBadge Status="@r.Status" />
                                        </td>
                                    </tr>
                                }
                                @foreach (var i in recentIssues)
                                {
                                    <tr>
                                        <td data-label="Mã phiếu">
                                            <a href="issues" class="fw-bold text-danger text-decoration-none font-monospace">@i.IssueNumber</a>
                                        </td>
                                        <td data-label="Loại">
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger-subtle rounded-pill px-2 py-0.5">Xuất</span>
                                        </td>
                                        <td data-label="Đối tác">
                                            <div class="text-truncate" style="max-width: 150px;">@i.CustomerOrDepartment</div>
                                        </td>
                                        <td data-label="Tổng tiền" class="text-end fw-semibold text-danger font-monospace">
                                            @((i.TotalAmount).ToString("N0")) đ
                                        </td>
                                        <td data-label="Trạng thái" class="text-end">
                                            <ReceiptStatusBadge Status="@i.Status" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private string errorMessage = string.Empty;

    private int totalProducts = 0;
    private int totalInventoryUnits = 0;
    private int activeCategories = 0;
    private double totalStockValue = 0;
    private int lowStockCount = 0;
    private int outOfStockCount = 0;

    private int pendingCount = 0;
    private int pendingReceiptsCount = 0;
    private int pendingIssuesCount = 0;

    private int totalReceiptsCount = 0;
    private int totalApprovedReceiptsCount = 0;
    private int totalImportUnits = 0;

    private int totalIssuesCount = 0;
    private int totalApprovedIssuesCount = 0;
    private int totalExportUnits = 0;

    private List<Product> lowStockProducts = new();
    private List<GoodsReceipt> recentReceipts = new();
    private List<GoodsIssue> recentIssues = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardData();
    }

    private async Task LoadDashboardData()
    {
        isLoading = true;
        errorMessage = string.Empty;
        try
        {
            var products = (await SearchProducts.ExecuteAsync()).ToList();
            totalProducts = products.Count;
            totalInventoryUnits = products.Sum(p => p.CurrentStock);
            activeCategories = products.Select(p => p.Category).Distinct().Count();
            totalStockValue = products.Sum(p => (double)p.CurrentStock * p.Price);
            lowStockCount = products.Count(p => p.CurrentStock > 0 && p.CurrentStock <= p.MinStockLevel);
            outOfStockCount = products.Count(p => p.CurrentStock <= 0);
            lowStockProducts = products.Where(p => p.CurrentStock <= p.MinStockLevel).OrderBy(p => p.CurrentStock).ToList();

            var receipts = (await ViewReceipts.ExecuteListAsync()).ToList();
            totalReceiptsCount = receipts.Count;
            pendingReceiptsCount = receipts.Count(r => r.Status == ReceiptStatus.Draft);
            totalApprovedReceiptsCount = receipts.Count(r => r.Status == ReceiptStatus.Approved);
            totalImportUnits = receipts.Where(r => r.Status == ReceiptStatus.Approved).SelectMany(r => r.Lines).Sum(l => l.Quantity);

            var issues = (await ViewIssues.ExecuteListAsync()).ToList();
            totalIssuesCount = issues.Count;
            pendingIssuesCount = issues.Count(i => i.Status == ReceiptStatus.Draft);
            totalApprovedIssuesCount = issues.Count(i => i.Status == ReceiptStatus.Approved);
            totalExportUnits = issues.Where(i => i.Status == ReceiptStatus.Approved).SelectMany(i => i.Lines).Sum(l => l.Quantity);

            pendingCount = pendingReceiptsCount + pendingIssuesCount;

            recentReceipts = receipts.OrderByDescending(r => r.Id).Take(3).ToList();
            recentIssues = issues.OrderByDescending(i => i.Id).Take(3).ToList();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetProductImage(string? url)
    {
        if (string.IsNullOrWhiteSpace(url)) return "images/default-product.svg";
        return url;
    }
}
