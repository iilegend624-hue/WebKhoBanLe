<!-- ========================================================================= -->
<!-- KHU VỰC IN CHUYÊN BIỆT (PRINT-ONLY AREA K80 THERMAL RECEIPT)              -->
<!-- Luôn luôn kết xuất nội dung hóa đơn chuẩn xác, không bao giờ bị trang trắng -->
<!-- ========================================================================= -->
@{
    var activePrintOrder = GetEffectiveOrderForPrint();
}
<div id="pos-printable-invoice" class="print-only-invoice">
    <div style="text-align: center; border-bottom: 1px dashed #000; padding-bottom: 8px; margin-bottom: 8px;">
        <div style="font-size: 13pt; font-weight: bold; text-transform: uppercase; letter-spacing: 0.5px;">CỬA HÀNG TIỆN LỢI & KHO ECO</div>
        <div style="font-size: 8.5pt; color: #333;">120 Nguyễn Huệ, P. Bến Nghé, Q.1, TP.HCM</div>
        <div style="font-size: 8.5pt; color: #333;">Hotline: 1900 6868 - 0903 123 456</div>
        <div style="font-size: 11pt; font-weight: bold; margin-top: 6px; text-transform: uppercase;">HÓA ĐƠN BÁN LẺ POS</div>
        <div style="font-size: 9pt;">Số HĐ: <strong>@activePrintOrder.OrderNumber</strong></div>
        <div style="font-size: 8pt; color: #444;">Ngày: @activePrintOrder.OrderDate.ToString("dd/MM/yyyy HH:mm:ss")</div>
        <div style="font-size: 8pt; color: #444;">Thu ngân: <strong>@activePrintOrder.CashierName</strong></div>
        <div style="font-size: 8pt; color: #444;">Khách hàng: <strong>@activePrintOrder.CustomerName</strong></div>
    </div>

    <table style="width: 100%; font-size: 8pt; border-collapse: collapse; margin-bottom: 8px;">
        <thead>
            <tr style="border-bottom: 1px dashed #000; font-weight: bold;">
                <th style="text-align: left; padding: 4px 0;">Mặt hàng</th>
                <th style="text-align: center; padding: 4px 0; width: 35px;">SL</th>
                <th style="text-align: right; padding: 4px 0; width: 60px;">Đ.Giá</th>
                <th style="text-align: right; padding: 4px 0; width: 70px;">T.Tiền</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var line in activePrintOrder.Lines)
            {
                <tr style="border-bottom: 1px dotted #ccc;">
                    <td style="padding: 4px 0;">
                        <div>@(line.Product?.Name ?? $"SP #{line.ProductId}")</div>
                        @if (!string.IsNullOrEmpty(line.Product?.Sku))
                        {
                            <div style="font-size: 7pt; color: #666;">@line.Product.Sku</div>
                        }
                    </td>
                    <td style="text-align: center; padding: 4px 0;">@line.Quantity</td>
                    <td style="text-align: right; padding: 4px 0;">@line.UnitPrice.ToString("N0")</td>
                    <td style="text-align: right; padding: 4px 0; font-weight: bold;">@line.LineTotal.ToString("N0")</td>
                </tr>
            }
        </tbody>
    </table>

    <div style="border-top: 1px dashed #000; padding-top: 6px; font-size: 8.5pt;">
        <div style="display: flex; justify-content: space-between; margin-bottom: 2px;">
            <span>Tạm tính:</span>
            <span>@activePrintOrder.SubTotal.ToString("N0") đ</span>
        </div>
        @if (activePrintOrder.DiscountAmount > 0)
        {
            <div style="display: flex; justify-content: space-between; margin-bottom: 2px;">
                <span>Giảm giá:</span>
                <span>-@activePrintOrder.DiscountAmount.ToString("N0") đ</span>
            </div>
        }
        <div style="display: flex; justify-content: space-between; font-weight: bold; font-size: 11pt; border-top: 1px dashed #000; border-bottom: 1px dashed #000; padding: 5px 0; margin: 4px 0;">
            <span>TỔNG CỘNG:</span>
            <span>@activePrintOrder.TotalAmount.ToString("N0") đ</span>
        </div>
        <div style="display: flex; justify-content: space-between; font-size: 8pt; margin-bottom: 2px;">
            <span>Hình thức TT:</span>
            <strong>@activePrintOrder.PaymentMethod</strong>
        </div>
        <div style="display: flex; justify-content: space-between; font-size: 8pt; margin-bottom: 2px;">
            <span>Tiền khách đưa:</span>
            <span>@activePrintOrder.ReceivedAmount.ToString("N0") đ</span>
        </div>
        <div style="display: flex; justify-content: space-between; font-size: 8pt; font-weight: bold;">
            <span>Tiền thối lại:</span>
            <span>@activePrintOrder.ChangeAmount.ToString("N0") đ</span>
        </div>
    </div>

    <div style="text-align: center; margin-top: 12px; padding-top: 8px; border-top: 1px dashed #000; font-size: 8pt;">
        <div style="font-weight: bold; text-transform: uppercase;">CẢM ƠN QUÝ KHÁCH & HẸN GẶP LẠI!</div>
        <div style="color: #666; font-size: 7.5pt; margin-top: 2px;">Quý khách vui lòng kiểm tra hàng & hóa đơn trước khi rời quầy</div>
        <div style="color: #888; font-size: 7pt; margin-top: 4px;">KhoBanLe POS System &bull; Powered by Clean Architecture</div>
    </div>
</div>

@code {
    private string activeTab = "pos";
    private List<Product> allProducts = new();
    private List<Customer> customersList = new();
    private List<PosOrder> posOrders = new();

    private List<string> categoriesList = new()
    {
        "Tất cả",
        "Nước giải khát & Bia",
        "Bánh kẹo & Đồ ăn vặt",
        "Sữa & Chế phẩm sữa",
        "Thực phẩm & Gia vị",
        "Hóa mỹ phẩm & Đồ gia dụng",
        "Văn phòng phẩm"
    };

    private string selectedCategory = "Tất cả";
    private string searchFilter = string.Empty;
    private string customerName = "Khách mua lẻ tại quầy";
    private int? selectedCustomerId = null;
    private string paymentMethod = "Chuyển khoản QR";
    private double discountAmount = 0;
    private double receivedCash = 0;
    private bool qrPaymentConfirmed = true;
    private bool cardPaymentConfirmed = true;

    private string qrDisplayMode = "card"; // "card" (mã QR Vietcombank của mình) hoặc "dynamic"
    private bool autoOpenPrintAfterCheckout = true;
    private bool showQrCardModal = false;
    private bool showSuccessModal = false;
    private List<StockDeductionInfo> deductedStockDetails = new();

    private string alertMessage = string.Empty;
    private bool isSuccessAlert = false;
    private bool isCheckingOut = false;
    private CheckoutResult? lastReceipt;
    private PosOrder? selectedOrderDetails;
    private PosOrder? orderToCancel;
    private string cancelReason = string.Empty;
    private PosOrder? orderForPrint;

    // Filter cho tab lịch sử
    private string historyPayFilter = "all";
    private string historySearchTerm = string.Empty;

    // Fast Customer Add Modal
    private bool showAddCustomerModal = false;
    private string newCustName = string.Empty;
    private string newCustPhone = string.Empty;
    private string newCustAddress = string.Empty;

    private string tempOrderSuffix = DateTime.Now.ToString("HHmmss");

    private IEnumerable<Product> FilteredProducts
    {
        get
        {
            var list = allProducts.AsEnumerable();
            if (selectedCategory != "Tất cả")
            {
                list = list.Where(p => p.Category.Equals(selectedCategory, StringComparison.OrdinalIgnoreCase));
            }
            if (!string.IsNullOrWhiteSpace(searchFilter))
            {
                list = list.Where(p => KhoBanLe.Services.SearchHelper.Matches(p.Name, searchFilter) ||
                                       KhoBanLe.Services.SearchHelper.Matches(p.Sku, searchFilter) ||
                                       KhoBanLe.Services.SearchHelper.Matches(p.Category, searchFilter));
            }
            return list;
        }
    }

    private IEnumerable<PosOrder> FilteredHistoryOrders
    {
        get
        {
            var list = posOrders.AsEnumerable();
            if (historyPayFilter != "all")
            {
                list = list.Where(o => o.PaymentMethod.Contains(historyPayFilter, StringComparison.OrdinalIgnoreCase));
            }
            if (!string.IsNullOrWhiteSpace(historySearchTerm))
            {
                list = list.Where(o => o.OrderNumber.Contains(historySearchTerm, StringComparison.OrdinalIgnoreCase) ||
                                       o.CustomerName.Contains(historySearchTerm, StringComparison.OrdinalIgnoreCase));
            }
            return list;
        }
    }

    private double PayableAmount => Math.Max(0, CartService.TotalAmount - discountAmount);
    private double ChangeAmount => Math.Max(0, receivedCash - PayableAmount);

    private bool IsCheckoutDisabled
    {
        get
        {
            if (paymentMethod == "Tiền mặt" && receivedCash < PayableAmount) return true;
            return false;
        }
    }

    private string VietQrImageUrl =>
        $"https://img.vietqr.io/image/VCB-1041587637-compact2.png?amount={(long)PayableAmount}&addInfo=Thanh%20toan%20POS%20{tempOrderSuffix}&accountName=NGUYEN%20TRUNG%20QUYET";

    [SupplyParameterFromQuery(Name = "scan")]
    public string? QueryScanSku { get; set; }

    private string barcodeScanInput = string.Empty;

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(QueryScanSku))
        {
            var targetProd = allProducts.FirstOrDefault(p => p.Sku.Equals(QueryScanSku, StringComparison.OrdinalIgnoreCase));
            if (targetProd != null)
            {
                if (targetProd.CurrentStock > 0)
                {
                    QuickAdd(targetProd);
                    alertMessage = $"Đã nhận diện mã QR: Đã thêm '{targetProd.Name}' (SKU: {targetProd.Sku}) vào đơn bán lẻ!";
                    isSuccessAlert = true;
                }
                else
                {
                    alertMessage = $"Sản phẩm '{targetProd.Name}' đã hết hàng trong kho (Tồn = 0), không thể bán!";
                    isSuccessAlert = false;
                }
            }
        }
    }

    private void HandleBarcodeKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            HandleBarcodeSubmit();
        }
    }

    private void HandleBarcodeSubmit()
    {
        if (string.IsNullOrWhiteSpace(barcodeScanInput)) return;

        string cleanInput = barcodeScanInput.Trim();
        var prod = allProducts.FirstOrDefault(p => 
            p.Sku.Equals(cleanInput, StringComparison.OrdinalIgnoreCase) ||
            p.Name.Equals(cleanInput, StringComparison.OrdinalIgnoreCase));

        if (prod == null)
        {
            prod = allProducts.FirstOrDefault(p => 
                p.Sku.Contains(cleanInput, StringComparison.OrdinalIgnoreCase) ||
                KhoBanLe.Services.SearchHelper.Matches(p.Name, cleanInput));
        }

        if (prod != null)
        {
            if (prod.CurrentStock > 0)
            {
                QuickAdd(prod);
                alertMessage = $"Quét mã thành công: Đã thêm '{prod.Name}' (SKU: {prod.Sku}) vào giỏ bán lẻ!";
                isSuccessAlert = true;
                barcodeScanInput = string.Empty;
            }
            else
            {
                alertMessage = $"Sản phẩm '{prod.Name}' hiện đã hết hàng trong kho (Tồn: 0)!";
                isSuccessAlert = false;
            }
        }
        else
        {
            alertMessage = $"Không tìm thấy mặt hàng nào khớp với mã SKU: '{cleanInput}'!";
            isSuccessAlert = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        CartService.OnChange += OnCartUpdated;
        allProducts = (await SearchProducts.ExecuteAsync()).ToList();

        var dynamicCats = allProducts.Select(p => p.Category)
                                     .Where(c => !string.IsNullOrWhiteSpace(c))
                                     .Distinct()
                                     .OrderBy(c => c)
                                     .ToList();
        categoriesList = new List<string> { "Tất cả" };
        categoriesList.AddRange(dynamicCats);

        customersList = (await GetCustomers.ExecuteAsync()).ToList();
        await LoadPosOrders();
        receivedCash = PayableAmount;
    }

    private async Task LoadPosOrders()
    {
        posOrders = (await GetPosOrders.ExecuteAsync()).ToList();
    }

    private async Task SwitchToHistoryTab()
    {
        activeTab = "history";
        await LoadPosOrders();
    }

    private async void OnCartUpdated()
    {
        if (receivedCash < PayableAmount)
        {
            receivedCash = PayableAmount;
        }
        await InvokeAsync(StateHasChanged);
    }

    private void OnCustomerSelected(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int cId) && cId > 0)
        {
            selectedCustomerId = cId;
            var cust = customersList.FirstOrDefault(c => c.Id == cId);
            if (cust != null)
            {
                customerName = cust.Name;
            }
        }
        else
        {
            selectedCustomerId = null;
            customerName = "Khách mua lẻ tại quầy";
        }
    }

    private void SetPaymentMethod(string method)
    {
        paymentMethod = method;
        if (paymentMethod != "Tiền mặt")
        {
            receivedCash = PayableAmount;
        }
    }

    private double RoundUpTo(double amount, double denomination)
    {
        if (amount <= 0) return denomination;
        return Math.Ceiling(amount / denomination) * denomination;
    }

    private void QuickAdd(Product prod)
    {
        var err = CartService.AddToCart(prod, 1);
        if (!string.IsNullOrEmpty(err))
        {
            alertMessage = err;
            isSuccessAlert = false;
        }
        else
        {
            alertMessage = $"Đã thêm '{prod.Name}' vào đơn POS!";
            isSuccessAlert = true;
            receivedCash = PayableAmount;
        }
    }

    private void UpdateQty(int productId, int newQty)
    {
        var err = CartService.UpdateQuantity(productId, newQty);
        if (!string.IsNullOrEmpty(err))
        {
            alertMessage = err;
            isSuccessAlert = false;
        }
        else
        {
            receivedCash = PayableAmount;
        }
    }

    private void OnInputQty(int productId, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int qty))
        {
            UpdateQty(productId, qty);
        }
    }

    private async Task HandleCheckout()
    {
        if (!CartService.Items.Any())
        {
            alertMessage = "Giỏ hàng bán lẻ đang trống! Vui lòng chọn sản phẩm vào giỏ trước khi thanh toán.";
            isSuccessAlert = false;
            return;
        }

        isCheckingOut = true;
        alertMessage = string.Empty;

        // Tự động xác nhận thanh toán khi bấm nút Thanh toán
        if (paymentMethod == "Chuyển khoản QR")
        {
            qrPaymentConfirmed = true;
        }
        else if (paymentMethod == "Quẹt thẻ POS")
        {
            cardPaymentConfirmed = true;
        }

        // Lưu trữ lại danh sách sản phẩm và tồn kho trước khi thanh toán
        var itemsBeforeCheckout = CartService.Items.Select(i => new
        {
            i.ProductId,
            ProductName = i.Product?.Name ?? $"Mã #{i.ProductId}",
            Unit = i.Product?.Unit ?? "Cái",
            QuantitySold = i.Quantity,
            OldStock = allProducts.FirstOrDefault(p => p.Id == i.ProductId)?.CurrentStock ?? 0
        }).ToList();

        var result = await CartService.CheckoutAsync(
            customerName, 
            paymentMethod, 
            selectedCustomerId, 
            paymentMethod == "Tiền mặt" ? receivedCash : PayableAmount, 
            discountAmount
        );

        isCheckingOut = false;

        if (result.Success)
        {
            lastReceipt = result;
            tempOrderSuffix = DateTime.Now.ToString("HHmmss");

            // Cập nhật lại sản phẩm từ cơ sở dữ liệu để đồng bộ số lượng tồn kho mới nhất
            allProducts = (await SearchProducts.ExecuteAsync()).ToList();
            await LoadPosOrders();

            // Tính toán chi tiết tồn kho trước & sau để hiển thị rõ ràng trên thông báo
            deductedStockDetails = itemsBeforeCheckout.Select(b =>
            {
                var currentProd = allProducts.FirstOrDefault(p => p.Id == b.ProductId);
                int newStock = currentProd != null ? currentProd.CurrentStock : (b.OldStock - b.QuantitySold);
                return new StockDeductionInfo
                {
                    ProductId = b.ProductId,
                    ProductName = b.ProductName,
                    Unit = b.Unit,
                    QuantitySold = b.QuantitySold,
                    StockBefore = b.OldStock,
                    StockAfter = newStock
                };
            }).ToList();

            orderForPrint = BuildOrderFromReceipt(result);
            var stockDetailsSummary = string.Join(", ", deductedStockDetails.Select(d => $"{d.ProductName} (-{d.QuantitySold} {d.Unit}, còn tồn {d.StockAfter} {d.Unit})"));
            alertMessage = $"Thanh toán thành công đơn {result.PosOrderNumber}! Đã tự động trừ tồn kho: {stockDetailsSummary}. Phiếu xuất #{result.IssueNumber} đã tạo.";
            isSuccessAlert = true;
            showSuccessModal = true;

            discountAmount = 0;
            receivedCash = 0;

            if (autoOpenPrintAfterCheckout)
            {
                await Task.Delay(350);
                await JS.InvokeVoidAsync("window.print");
            }
        }
        else
        {
            alertMessage = result.ErrorMessage ?? "Thanh toán POS thất bại!";
            isSuccessAlert = false;
        }

        await InvokeAsync(StateHasChanged);
    }

    private PosOrder BuildOrderFromReceipt(CheckoutResult receipt)
    {
        return new PosOrder
        {
            OrderNumber = receipt.PosOrderNumber ?? "POS-RECEIPT",
            OrderDate = receipt.OrderDate,
            CashierName = "Thu ngân / Bán lẻ POS",
            CustomerName = receipt.CustomerName,
            PaymentMethod = receipt.PaymentMethod,
            SubTotal = receipt.SubTotal,
            DiscountAmount = receipt.DiscountAmount,
            TotalAmount = receipt.TotalAmount,
            ReceivedAmount = receipt.ReceivedAmount,
            ChangeAmount = receipt.ChangeAmount,
            Status = "Paid",
            Lines = receipt.PurchasedItems.Select(p => new PosOrderLine
            {
                ProductId = p.ProductId,
                Product = p.Product,
                Quantity = p.Quantity,
                UnitPrice = p.UnitPrice
            }).ToList()
        };
    }

    private PosOrder GetEffectiveOrderForPrint()
    {
        if (orderForPrint != null) return orderForPrint;
        if (selectedOrderDetails != null) return selectedOrderDetails;
        if (lastReceipt != null) return BuildOrderFromReceipt(lastReceipt);
        if (posOrders.Any()) return posOrders.First();

        var cartItems = CartService.Items.ToList();
        return new PosOrder
        {
            OrderNumber = $"POS-{DateTime.Now:yyyyMMddHHmmss}",
            OrderDate = DateTime.Now,
            CashierName = "Thu ngân / Bán lẻ POS",
            CustomerName = string.IsNullOrWhiteSpace(customerName) ? "Khách mua lẻ tại quầy" : customerName,
            PaymentMethod = string.IsNullOrWhiteSpace(paymentMethod) ? "Tiền mặt" : paymentMethod,
            SubTotal = CartService.TotalAmount,
            DiscountAmount = discountAmount,
            TotalAmount = PayableAmount,
            ReceivedAmount = receivedCash > 0 ? receivedCash : PayableAmount,
            ChangeAmount = ChangeAmount,
            Status = "Paid",
            Lines = cartItems.Any()
                ? cartItems.Where(ci => ci.Product != null).Select(ci => new PosOrderLine
                {
                    ProductId = ci.Product!.Id,
                    Product = ci.Product,
                    Quantity = ci.Quantity,
                    UnitPrice = ci.Product.Price
                }).ToList()
                : new List<PosOrderLine>
                {
                    new PosOrderLine
                    {
                        ProductId = 1,
                        Product = new Product { Name = "Hóa đơn mẫu bán lẻ POS", Sku = "POS-SAMPLE", Price = 0 },
                        Quantity = 1,
                        UnitPrice = 0
                    }
                }
        };
    }

    private async Task PrintCurrentReceipt()
    {
        orderForPrint = GetEffectiveOrderForPrint();
        await InvokeAsync(StateHasChanged);
        await Task.Delay(200);
        await JS.InvokeVoidAsync("window.print");
    }

    private async Task ExportCurrentReceiptExcel()
    {
        var targetOrder = orderForPrint ?? (lastReceipt != null ? BuildOrderFromReceipt(lastReceipt) : null) ?? GetEffectiveOrderForPrint();
        if (targetOrder == null) return;

        await ExcelService.ExportSinglePosOrderToExcelAsync(targetOrder);
        alertMessage = $"Đã xuất thành công hóa đơn {targetOrder.OrderNumber} ra file Excel!";
        isSuccessAlert = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task PrintAndExportReceipt()
    {
        await ExportCurrentReceiptExcel();
        await Task.Delay(250);
        await PrintCurrentReceipt();
    }

    private void ConfirmPrintSpecificOrder(PosOrder order)
    {
        orderForPrint = order;
        deductedStockDetails = order.Lines.Select(l => new StockDeductionInfo
        {
            ProductId = l.ProductId,
            ProductName = l.Product?.Name ?? $"Mặt hàng #{l.ProductId}",
            Unit = l.Product?.Unit ?? "Cái",
            QuantitySold = l.Quantity,
            StockBefore = (l.Product?.CurrentStock ?? 0) + l.Quantity,
            StockAfter = l.Product?.CurrentStock ?? 0
        }).ToList();
        showSuccessModal = true;
    }

    private void CloseInvoiceModal()
    {
        showSuccessModal = false;
        orderForPrint = null;
    }

    private async Task CopyToClipboard(string text)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            alertMessage = $"Đã sao chép: {text}";
            isSuccessAlert = true;
        }
        catch
        {
            // fallback nếu trình duyệt không hỗ trợ quyền sao chép
        }
    }

    private void ViewOrderModal(PosOrder order)
    {
        selectedOrderDetails = order;
    }

    private async Task PrintLastReceipt()
    {
        if (lastReceipt != null)
        {
            orderForPrint = BuildOrderFromReceipt(lastReceipt);
        }
        else if (posOrders.Any())
        {
            orderForPrint = posOrders.First();
        }
        else
        {
            orderForPrint = GetEffectiveOrderForPrint();
        }
        await InvokeAsync(StateHasChanged);
        await Task.Delay(200);
        await JS.InvokeVoidAsync("window.print");
    }

    private async Task PrintSpecificOrder(PosOrder order)
    {
        orderForPrint = order;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(200);
        await JS.InvokeVoidAsync("window.print");
    }

    private async Task ExportLastReceiptExcel()
    {
        await ExportCurrentReceiptExcel();
    }

    private async Task ExportSpecificOrderExcel(PosOrder order)
    {
        await ExcelService.ExportSinglePosOrderToExcelAsync(order);
    }

    private async Task ExportPosExcel()
    {
        await ExcelService.ExportPosOrdersToExcelAsync(posOrders);
    }

    private void PromptCancelOrder(PosOrder order)
    {
        orderToCancel = order;
        cancelReason = "Khách yêu cầu hoàn đơn";
    }

    private async Task HandleConfirmCancelOrder()
    {
        if (orderToCancel == null) return;
        bool ok = await CancelPosOrder.ExecuteAsync(orderToCancel.Id, cancelReason);
        if (ok)
        {
            alertMessage = $"Đã hủy đơn {orderToCancel.OrderNumber} thành công và hoàn trả tồn kho!";
            isSuccessAlert = true;
            allProducts = (await SearchProducts.ExecuteAsync()).ToList();
            await LoadPosOrders();
        }
        else
        {
            alertMessage = "Không thể hủy đơn hàng này.";
            isSuccessAlert = false;
        }
        orderToCancel = null;
    }

    private async Task HandleCreateQuickCustomer()
    {
        if (string.IsNullOrWhiteSpace(newCustName))
        {
            alertMessage = "Vui lòng nhập tên khách hàng!";
            isSuccessAlert = false;
            return;
        }

        var newCust = new Customer
        {
            CustomerCode = $"KH-{DateTime.Now:MMdd}-{Guid.NewGuid().ToString()[..3].ToUpper()}",
            Name = newCustName.Trim(),
            Phone = string.IsNullOrWhiteSpace(newCustPhone) ? "0900 000 000" : newCustPhone.Trim(),
            Address = string.IsNullOrWhiteSpace(newCustAddress) ? "Mua tại quầy" : newCustAddress.Trim(),
            Email = "khachle@khobanle.vn",
            Points = 10
        };

        await AddCustomer.ExecuteAsync(newCust);
        customersList = (await GetCustomers.ExecuteAsync()).ToList();
        selectedCustomerId = newCust.Id;
        customerName = newCust.Name;
        showAddCustomerModal = false;
        alertMessage = $"Đã thêm khách hàng mới '{newCust.Name}' thành công!";
        isSuccessAlert = true;
        newCustName = string.Empty;
        newCustPhone = string.Empty;
        newCustAddress = string.Empty;
    }

    public void Dispose()
    {
        CartService.OnChange -= OnCartUpdated;
    }

    public class StockDeductionInfo
    {
        public int ProductId { get; set; }
        public string ProductName { get; set; } = string.Empty;
        public string Unit { get; set; } = string.Empty;
        public int QuantitySold { get; set; }
        public int StockBefore { get; set; }
