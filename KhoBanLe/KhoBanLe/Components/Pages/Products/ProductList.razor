@page "/products"
@rendermode InteractiveServer
@namespace KhoBanLe.Components.Pages.Products
@inject ISearchProductsUseCase SearchProducts
@inject IAddProductUseCase AddProduct
@inject IEditProductUseCase EditProduct
@inject IDeleteProductUseCase DeleteProduct
@inject ShoppingCartService CartService
@inject ExcelExportService ExcelService
@inject UserRoleService RoleService
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Danh Mục Hàng Hóa Bán Lẻ & Tồn Kho - KhoBanLe</PageTitle>

<!-- Toast Thông Báo Thêm Vào Giỏ Hàng -->
@if (showToast)
{
    <div class="toast-notice d-flex align-items-center gap-3">
        <div class="rounded-circle bg-success bg-opacity-15 text-success p-2 d-flex align-items-center justify-content-center shadow-xs" style="width: 40px; height: 40px;">
            <i class="bi bi-cart-check-fill fs-5"></i>
        </div>
        <div>
            <div class="fw-bold text-dark small mb-0">@toastMessage</div>
            <div class="d-flex gap-2 mt-1">
                <button type="button" class="btn btn-xs btn-primary rounded-pill px-2.5 py-0.5 fw-semibold" @onclick="CartService.OpenDrawer">
                    Xem giỏ hàng &rarr;
                </button>
                <a href="cart" class="text-muted small text-decoration-none pt-0.5">Mở quầy POS</a>
            </div>
        </div>
        <button type="button" class="btn-close ms-2" style="font-size: 0.75rem;" @onclick="() => showToast = false"></button>
    </div>
}

<!-- EXECUTIVE RETAIL INVENTORY DASHBOARD HEADER (MỤC TIÊU GIAO DIỆN HIỆN ĐẠI) -->
<div class="retail-dashboard-header">
    <div class="container-fluid px-3 px-xl-4">
        <div class="row align-items-center g-3">
            <div class="col-12 col-xl-5">
                <div class="d-flex align-items-center gap-2 mb-1.5">
                    <span class="badge bg-success text-white fw-bold px-2.5 py-1 rounded-pill shadow-xs">
                        <i class="bi bi-shop me-1"></i>ECO2415 CAPSTONE ĐỀ TÀI 13
                    </span>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-bold px-2.5 py-1 rounded-pill">
                        <i class="bi bi-database-check me-1"></i>SQL Server Dapper
                    </span>
                </div>
                <h2 class="fw-bold text-dark mb-1 tracking-tight">
                    <i class="bi bi-boxes text-success me-2"></i>Kho Hàng Bán Lẻ & Siêu Thị Tiện Lợi
                </h2>
                <p class="text-muted small mb-0">
                    Quản lý hơn 110+ mặt hàng thiết yếu thuộc 10 ngành hàng &bull; Đồng bộ tồn kho tức thì &bull; Bán hàng tại quầy POS &bull; In tem mã QR
                </p>
            </div>
            <div class="col-12 col-xl-7">
                <div class="row g-2">
                    <div class="col-6 col-sm-3">
                        <div class="kpi-mini-card p-2.5 rounded-3 bg-white border shadow-xs text-center h-100">
                            <div class="text-muted small fw-semibold">Tổng Hàng Hóa</div>
                            <div class="h4 fw-bold text-dark mb-0">@allProducts.Count</div>
                            <small class="text-success fw-semibold" style="font-size: 0.72rem;">@allCategories.Count(c => c != "Tất cả") ngành hàng</small>
                        </div>
                    </div>
                    <div class="col-6 col-sm-3">
                        <div class="kpi-mini-card p-2.5 rounded-3 bg-white border border-success-subtle shadow-xs text-center h-100">
                            <div class="text-muted small fw-semibold">Tồn An Toàn</div>
                            <div class="h4 fw-bold text-success mb-0">@(allProducts.Count(p => p.CurrentStock > p.MinStockLevel))</div>
                            <small class="text-muted" style="font-size: 0.72rem;">Đầy đủ hàng bán</small>
                        </div>
                    </div>
                    <div class="col-6 col-sm-3">
                        <div class="kpi-mini-card p-2.5 rounded-3 bg-white border border-warning-subtle shadow-xs text-center h-100">
                            <div class="text-muted small fw-semibold">Sắp Hết Hàng</div>
                            <div class="h4 fw-bold text-warning-emphasis mb-0">@(allProducts.Count(p => p.CurrentStock > 0 && p.CurrentStock <= p.MinStockLevel))</div>
                            <small class="text-warning-emphasis" style="font-size: 0.72rem;">Cần nhập thêm</small>
                        </div>
                    </div>
                    <div class="col-6 col-sm-3">
                        <div class="kpi-mini-card p-2.5 rounded-3 bg-white border border-danger-subtle shadow-xs text-center h-100">
                            <div class="text-muted small fw-semibold">Hết Hàng</div>
                            <div class="h4 fw-bold text-danger mb-0">@(allProducts.Count(p => p.CurrentStock <= 0))</div>
                            <small class="text-danger" style="font-size: 0.72rem;">Tồn kho = 0</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid px-3 px-xl-4">
    <!-- Alert status -->
    @if (!string.IsNullOrEmpty(alertMessage))
    {
        <div class="alert @(isSuccessAlert ? "alert-success border-success" : "alert-danger border-danger") alert-dismissible fade show rounded-3 shadow-xs mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi @(isSuccessAlert ? "bi-check-circle-fill text-success fs-5" : "bi-exclamation-triangle-fill text-danger fs-5")"></i>
                <div class="fw-medium">@alertMessage</div>
            </div>
            <button type="button" class="btn-close" @onclick="() => alertMessage = string.Empty"></button>
        </div>
    }

    <!-- TWO-COLUMN LAYOUT: SIDEBAR + MAIN CONTENT (EXACT SAPO STORE STYLE) -->
    <div class="row g-4">
        <!-- 1. LEFT SIDEBAR: DANH MỤC & KHOẢNG GIÁ & TỒN KHO -->
        <div class="col-12 col-lg-3 col-xl-2">
            <!-- Box Danh Mục -->
            <div class="sapo-sidebar-box">
                <div class="sapo-sidebar-title">
                    <i class="bi bi-list-ul text-success fs-5"></i>
                    <span>Danh mục</span>
                </div>
                <div class="sapo-cat-list">
                    @foreach (var cat in allCategories)
                    {
                        int count = cat == "Tất cả" ? allProducts.Count : allProducts.Count(p => p.Category == cat);
                        bool isSelected = selectedCategory == cat;

                        <button type="button" class="sapo-cat-item @(isSelected ? "active" : "")"
                                @onclick="() => FilterByCategory(cat)">
                            <div class="d-flex align-items-center">
                                <span class="sapo-radio-bullet"></span>
                                <i class="bi @GetCategoryIcon(cat) me-1.5 opacity-75"></i>
                                <span>@cat</span>
                            </div>
                            <span class="badge @(isSelected ? "bg-success text-white" : "bg-light text-muted border") rounded-pill" style="font-size: 0.72rem;">
                                @count
                            </span>
                        </button>
                    }
                </div>
            </div>

            <!-- Box Khoảng Giá -->
            <div class="sapo-sidebar-box">
                <div class="sapo-sidebar-title">
                    <i class="bi bi-tag text-success fs-5"></i>
                    <span>Khoảng giá</span>
                </div>
                <div class="d-flex flex-column gap-1">
                    <button type="button" class="sapo-cat-item @(priceFilter == "all" ? "active" : "")"
                            @onclick='() => FilterByPriceRange("all")'>
                        <div class="d-flex align-items-center">
                            <span class="sapo-radio-bullet"></span>
                            <span>Tất cả mức giá</span>
                        </div>
                    </button>
                    <button type="button" class="sapo-cat-item @(priceFilter == "under_20k" ? "active" : "")"
                            @onclick='() => FilterByPriceRange("under_20k")'>
                        <div class="d-flex align-items-center">
                            <span class="sapo-radio-bullet"></span>
                            <span>Dưới 20.000 đ</span>
                        </div>
                    </button>
                    <button type="button" class="sapo-cat-item @(priceFilter == "20k_50k" ? "active" : "")"
                            @onclick='() => FilterByPriceRange("20k_50k")'>
                        <div class="d-flex align-items-center">
                            <span class="sapo-radio-bullet"></span>
                            <span>20k - 50.000 đ</span>
                        </div>
                    </button>
                    <button type="button" class="sapo-cat-item @(priceFilter == "50k_100k" ? "active" : "")"
                            @onclick='() => FilterByPriceRange("50k_100k")'>
                        <div class="d-flex align-items-center">
                            <span class="sapo-radio-bullet"></span>
                            <span>50k - 100.000 đ</span>
                        </div>
                    </button>
                    <button type="button" class="sapo-cat-item @(priceFilter == "above_100k" ? "active" : "")"
                            @onclick='() => FilterByPriceRange("above_100k")'>
                        <div class="d-flex align-items-center">
                            <span class="sapo-radio-bullet"></span>
                            <span>Trên 100.000 đ</span>
                        </div>
                    </button>
                </div>
            </div>

            <!-- Box Tình Trạng Kho Hàng -->
            <div class="sapo-sidebar-box">
                <div class="sapo-sidebar-title">
                    <i class="bi bi-boxes text-success fs-5"></i>
                    <span>Tình trạng kho</span>
                </div>
                <div class="d-flex flex-column gap-1">
                    <button type="button" class="sapo-cat-item @(stockFilter == "all" ? "active" : "")"
                            @onclick='() => FilterByStock("all")'>
                        <div class="d-flex align-items-center">
                            <span class="sapo-radio-bullet"></span>
                            <span>Tất cả tồn kho</span>
                        </div>
                    </button>
                    <button type="button" class="sapo-cat-item @(stockFilter == "in_stock" ? "active" : "")"
                            @onclick='() => FilterByStock("in_stock")'>
                        <div class="d-flex align-items-center">
                            <span class="sapo-radio-bullet"></span>
                            <span class="text-success">Còn hàng</span>
                        </div>
                    </button>
                    <button type="button" class="sapo-cat-item @(stockFilter == "low_stock" ? "active" : "")"
                            @onclick='() => FilterByStock("low_stock")'>
                        <div class="d-flex align-items-center">
                            <span class="sapo-radio-bullet"></span>
                            <span class="text-warning-emphasis">Sắp hết hàng</span>
                        </div>
                    </button>
                    <button type="button" class="sapo-cat-item @(stockFilter == "out_of_stock" ? "active" : "")"
                            @onclick='() => FilterByStock("out_of_stock")'>
                        <div class="d-flex align-items-center">
                            <span class="sapo-radio-bullet"></span>
                            <span class="text-danger">Hết hàng</span>
                        </div>
                    </button>
                </div>
            </div>

            <!-- Reset Filter Button -->
            @if (selectedCategory != "Tất cả" || priceFilter != "all" || stockFilter != "all" || !string.IsNullOrWhiteSpace(searchTerm))
            {
                <button type="button" class="btn btn-sm btn-outline-danger w-100 rounded-pill fw-semibold py-2 shadow-xs"
                        @onclick="ClearSearch">
                    <i class="bi bi-arrow-counterclockwise me-1"></i>Đặt lại bộ lọc
                </button>
            }
        </div>

        <!-- 2. RIGHT MAIN CONTENT: TOOLBAR & PRODUCT CARDS GRID -->
        <div class="col-12 col-lg-9 col-xl-10">
            <!-- SORTING & FILTER TOOLBAR (SAPO STYLE) -->
            <div class="sapo-sort-bar-container">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <!-- Left: Search & Count -->
                    <div class="d-flex flex-wrap align-items-center gap-2" style="min-width: 280px; flex: 1;">
                        <div style="flex: 1; min-width: 200px;">
                            <ProductSearchBar @bind-SearchTerm="searchTerm"
                                              OnSearch="ApplyFilters"
                                              OnClear="ClearSearch"
                                              ShowCategoryFilter="false"
                                              Placeholder="Tìm kiếm mã SKU, tên hàng hóa bán lẻ..." />
                        </div>
                        <span class="small text-muted fw-semibold ps-1">
                            (@filteredProducts.Count sản phẩm)
                        </span>
                    </div>

                    <!-- Right: Sắp xếp theo (Pills from screenshot) & Actions -->
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <span class="small text-muted fw-bold d-none d-sm-inline">Sắp xếp theo:</span>

                        <!-- Sắp xếp theo Giá ↑↓ -->
                        <button type="button" class="sapo-sort-pill @(sortBy.StartsWith("price") ? "active" : "")"
                                @onclick="TogglePriceSort" title="Sắp xếp theo giá tăng hoặc giảm dần">
                            <span>Giá</span>
                            <i class="bi @(sortBy == "price_desc" ? "bi-arrow-down" : "bi-arrow-up")"></i>
                        </button>

                        <!-- Dưới 1 triệu (Pill filter) -->
                        <button type="button" class="sapo-sort-pill @(priceFilter == "under_1m" ? "active" : "")"
                                @onclick="ToggleUnder1Million">
                            <span>Dưới 1 triệu</span>
                        </button>

                        <!-- Được mua nhiều (Pill filter) -->
                        <button type="button" class="sapo-sort-pill @(sortBy == "stock_desc" ? "active" : "")"
                                @onclick='() => SetSort("stock_desc")'>
                            <span>Được mua nhiều</span>
                        </button>

                        <!-- Mới nhất (Pill filter) -->
                        <button type="button" class="sapo-sort-pill @(sortBy == "id_desc" ? "active" : "")"
                                @onclick='() => SetSort("id_desc")'>
                            <span>Mới nhất</span>
                        </button>

                        <!-- View Mode Toggle -->
                        <div class="btn-group rounded-pill border p-0.5 bg-light ms-1" role="group">
                            <button type="button" class="btn btn-xs rounded-pill @(viewMode == "grid" ? "btn-primary text-white fw-bold" : "btn-light text-dark")"
                                    @onclick='() => viewMode = "grid"' title="Xem dạng thẻ">
                                <i class="bi bi-grid-fill"></i>
                            </button>
                            <button type="button" class="btn btn-xs rounded-pill @(viewMode == "table" ? "btn-primary text-white fw-bold" : "btn-light text-dark")"
                                    @onclick='() => viewMode = "table"' title="Xem dạng bảng">
                                <i class="bi bi-table"></i>
                            </button>
                        </div>

                        <!-- Action Buttons -->
                        <button class="btn btn-sm btn-outline-success rounded-pill fw-semibold shadow-xs" @onclick="ExportToExcel" title="Xuất file Excel danh mục">
                            <i class="bi bi-file-earmark-excel me-1"></i>Excel
                        </button>
                        <button class="btn btn-sm btn-primary rounded-pill fw-semibold shadow-xs" @onclick="OpenAddModal" title="Thêm mặt hàng mới">
                            <i class="bi bi-plus-lg me-1"></i>Thêm Mới
                        </button>
                    </div>

                    <!-- GỢI Ý TÌM NHANH (QUICK KEYWORD CHIPS) -->
                    <div class="d-flex flex-wrap align-items-center gap-1.5 w-100 mt-2.5 pt-2 border-top">
                        <small class="text-muted fw-bold me-1"><i class="bi bi-lightning-charge-fill text-warning me-1"></i>Gợi ý nhanh:</small>
                        <button type="button" class="btn btn-xs rounded-pill @(searchTerm == "h" ? "btn-success text-white shadow-xs fw-bold" : "btn-light text-secondary border")"
                                @onclick='() => SetQuickSearch("h")' title="Tìm mọi mặt hàng có chứa chữ 'h'">
                            Chữ "h"
                        </button>
                        <button type="button" class="btn btn-xs rounded-pill @(searchTerm == "haohao" || searchTerm == "hảo hảo" ? "btn-success text-white shadow-xs fw-bold" : "btn-light text-secondary border")"
                                @onclick='() => SetQuickSearch("haohao")'>
                            🍜 Mì Hảo Hảo
                        </button>
                        <button type="button" class="btn btn-xs rounded-pill @(searchTerm == "coca" ? "btn-success text-white shadow-xs fw-bold" : "btn-light text-secondary border")"
                                @onclick='() => SetQuickSearch("coca")'>
                            🥤 Coca-Cola
                        </button>
                        <button type="button" class="btn btn-xs rounded-pill @(searchTerm == "vinamilk" ? "btn-success text-white shadow-xs fw-bold" : "btn-light text-secondary border")"
                                @onclick='() => SetQuickSearch("vinamilk")'>
                            🥛 Sữa Vinamilk
                        </button>
                        <button type="button" class="btn btn-xs rounded-pill @(searchTerm == "omo" ? "btn-success text-white shadow-xs fw-bold" : "btn-light text-secondary border")"
                                @onclick='() => SetQuickSearch("omo")'>
                            🧼 Bột giặt OMO
                        </button>
                        <button type="button" class="btn btn-xs rounded-pill @(searchTerm == "thienlong" || searchTerm == "thiên long" ? "btn-success text-white shadow-xs fw-bold" : "btn-light text-secondary border")"
                                @onclick='() => SetQuickSearch("thienlong")'>
                            ✏️ Bút Thiên Long
                        </button>
                        <button type="button" class="btn btn-xs rounded-pill @(searchTerm == "simply" ? "btn-success text-white shadow-xs fw-bold" : "btn-light text-secondary border")"
                                @onclick='() => SetQuickSearch("simply")'>
                            🍳 Dầu Simply
                        </button>
                        <button type="button" class="btn btn-xs rounded-pill @(searchTerm == "g7" ? "btn-success text-white shadow-xs fw-bold" : "btn-light text-secondary border")"
                                @onclick='() => SetQuickSearch("g7")'>
                            ☕ Cà phê G7
                        </button>
                        @if (!string.IsNullOrWhiteSpace(searchTerm))
                        {
                            <button type="button" class="btn btn-xs btn-outline-danger rounded-pill ms-auto fw-semibold" @onclick="ClearSearch">
                                <i class="bi bi-x-circle me-1"></i>Xóa tìm kiếm
                            </button>
                        }
                    </div>
                </div>
            </div>

            <!-- PRODUCT DISPLAY: GRID OR TABLE -->
            @if (viewMode == "grid")
            {
                @if (filteredProducts.Any())
                {
                    <div class="row g-4 mb-4">
                        @foreach (var p in filteredProducts)
                        {
                            bool isJustAdded = justAddedIds.Contains(p.Id);

                            <div class="col-12 col-md-6 col-xl-4">
                                <div class="sapo-product-card">
                                    <!-- Image Preview with Badges -->
                                    <div class="sapo-card-image">
                                        <img src="@GetProductImage(p.ImageUrl)" 
                                             alt="@p.Name" 
                                             onerror="this.src='images/default-product.svg'" />
                                        
                                        <!-- Category Badge -->
                                        <div class="position-absolute top-0 start-0 m-2.5">
                                            <span class="product-badge-category shadow-xs">
                                                @p.Category
                                            </span>
                                        </div>

                                        <!-- Stock Status Badge (Reusable K3.1) -->
                                        <div class="position-absolute top-0 end-0 m-2.5">
                                            <StockStatusBadge CurrentStock="@p.CurrentStock" MinStock="@p.MinStockLevel" />
                                        </div>
                                    </div>

                                    <!-- Card Content Body -->
                                    <div class="sapo-card-body">
                                        <!-- Title: Bold, clear, 2 lines -->
                                        <h6 class="sapo-card-title" title="@p.Name">
                                            @p.Name
                                        </h6>

                                        <!-- Price Tag: Large green bold + strikethrough original price if exists -->
                                        <div class="sapo-card-price-row">
                                            <span class="sapo-price-main">@((p.Price).ToString("N0")) đ</span>
                                            @if (p.OriginalPrice.HasValue && p.OriginalPrice.Value > p.Price)
                                            {
                                                <span class="sapo-price-original">/ @((p.OriginalPrice.Value).ToString("N0")) đ</span>
                                            }
                                        </div>

                                        <!-- SKU & Stock Info -->
                                        <div class="d-flex align-items-center justify-content-between text-muted small mb-2">
                                            <span>Mã: <strong class="text-dark">@p.Sku</strong></span>
                                            <span>ĐVT: <strong class="text-dark">@p.Unit</strong></span>
                                            <span>Tồn: <strong class="@(p.CurrentStock <= 0 ? "text-danger" : (p.CurrentStock <= p.MinStockLevel ? "text-warning" : "text-success"))">@p.CurrentStock</strong></span>
                                        </div>

                                        <!-- SAPO STYLE ACTION BUTTONS: "XEM THỬ" & "CHI TIẾT" -->
                                        <div class="sapo-card-actions">
                                            <!-- Nút XEM THỬ (Solid Green Pill Button) -->
                                            <button type="button" class="btn-sapo-preview"
                                                    @onclick="() => OpenLivePreview(p)" title="Xem chi tiết và thông số sản phẩm">
                                                Xem thử
                                            </button>

                                            <!-- Nút CHI TIẾT (Green Outline Pill Button) -->
                                            <button type="button" class="btn-sapo-detail"
                                                    @onclick="() => OpenEditModal(p)" title="Xem chi tiết & chỉnh sửa thông tin">
                                                Chi tiết
                                            </button>

                                            <!-- Quick Add-to-Cart "+" Button -->
                                            <button type="button" class="btn-sapo-quick-cart @(isJustAdded ? "bg-success text-white" : "")"
                                                    disabled="@(p.CurrentStock <= 0)"
                                                    @onclick="() => HandleAddToCart(p)"
                                                    title="Thêm nhanh vào giỏ hàng">
                                                @if (isJustAdded)
                                                {
                                                    <i class="bi bi-check-lg"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-cart-plus"></i>
                                                }
                                            </button>

                                            <!-- Dropdown menu for more options -->
                                            <div class="dropdown">
                                                <button class="btn btn-sm btn-light border rounded-circle p-1.5" type="button" data-bs-toggle="dropdown" title="Tùy chọn khác">
                                                    <i class="bi bi-three-dots-vertical"></i>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3">
                                                    <li>
                                                        <button class="dropdown-item py-1.5 small text-success" @onclick="() => HandleBuyNow(p)">
                                                            <i class="bi bi-lightning-charge me-2"></i>Bán ngay tại quầy
                                                        </button>
                                                    </li>
                                                    <li>
                                                        <button class="dropdown-item py-1.5 small text-dark" @onclick="() => OpenQrModal(p)">
                                                            <i class="bi bi-qr-code-scan me-2 text-success"></i>Mã QR & Tem nhãn
                                                        </button>
                                                    </li>
                                                    <li>
                                                        <button class="dropdown-item py-1.5 small text-primary" @onclick="() => OpenEditModal(p)">
                                                            <i class="bi bi-pencil me-2 text-warning"></i>Sửa thông tin
                                                        </button>
                                                    </li>
                                                    <li>
                                                        <button class="dropdown-item py-1.5 small text-danger" @onclick="() => OpenDeleteConfirm(p)">
                                                            <i class="bi bi-trash3 me-2 text-danger"></i>Xóa hàng hóa
                                                        </button>
                                                    </li>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="sapo-sidebar-box p-5 text-center text-muted mb-4 border border-dashed rounded-4 bg-light bg-opacity-50">
                        <div class="rounded-circle bg-success bg-opacity-10 text-success d-inline-flex align-items-center justify-content-center mb-3 shadow-xs" style="width: 64px; height: 64px;">
                            <i class="bi bi-search fs-2"></i>
                        </div>
                        <h5 class="fw-bold text-dark mb-1">Không tìm thấy hàng hóa nào phù hợp!</h5>
                        <p class="small text-muted mb-3 max-w-md mx-auto">
                            Không có sản phẩm nào khớp với từ khóa "<strong>@searchTerm</strong>" trong bộ lọc hiện tại.
                        </p>
                        <div class="d-flex flex-wrap justify-content-center gap-2 mb-3">
                            <span class="small text-muted align-self-center">Thử bấm tìm:</span>
                            <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill" @onclick='() => SetQuickSearch("h")'>
                                Chữ cái "h"
                            </button>
                            <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill" @onclick='() => SetQuickSearch("haohao")'>
                                Mì Hảo Hảo
                            </button>
                            <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill" @onclick='() => SetQuickSearch("coca")'>
                                Coca-Cola
                            </button>
                            <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill" @onclick='() => SetQuickSearch("vinamilk")'>
                                Vinamilk
                            </button>
                        </div>
                        <button type="button" class="btn btn-success rounded-pill px-4 fw-bold shadow-xs" @onclick="ClearSearch">
                            <i class="bi bi-arrow-counterclockwise me-1.5"></i>Xem tất cả 111 sản phẩm
                        </button>
                    </div>
                }
            }
            else
            {
                <!-- TABLE VIEW -->
                <div class="sapo-sidebar-box p-0 overflow-hidden mb-4">
                    <div class="table-responsive">
                        <table class="table custom-table mb-0 align-middle">
                            <thead>
                                <tr>
                                    <th class="ps-3">HÌNH ẢNH</th>
                                    <th>MÃ HÀNG (SKU)</th>
                                    <th>TÊN HÀNG HÓA</th>
                                    <th>NGÀNH HÀNG</th>
                                    <th>ĐVT</th>
                                    <th class="text-end">ĐƠN GIÁ</th>
                                    <th class="text-center">TỒN KHO</th>
                                    <th class="text-center">TRẠNG THÁI</th>
                                    <th class="text-end pe-3">THAO TÁC</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in filteredProducts)
                                {
                                    <tr>
                                        <td class="ps-3" data-label="Hình ảnh">
                                            <div class="rounded-3 border shadow-xs d-flex align-items-center justify-content-center p-1" style="width: 48px; height: 48px; background: #ffffff;">
                                                <img src="@GetProductImage(p.ImageUrl)" 
                                                     alt="@p.Name" 
                                                     style="max-width: 100%; max-height: 100%; object-fit: contain;" 
                                                     onerror="this.src='images/default-product.svg'" />
                                            </div>
                                        </td>
                                        <td data-label="Mã SKU">
                                            <span class="badge bg-light text-dark border fw-bold">@p.Sku</span>
                                        </td>
                                        <td data-label="Tên hàng hóa">
                                            <div class="fw-bold text-dark">@p.Name</div>
                                            <small class="text-muted">@p.Description</small>
                                        </td>
                                        <td data-label="Ngành hàng">
                                            <span class="badge bg-light text-secondary border">@p.Category</span>
                                        </td>
                                        <td data-label="ĐVT">@p.Unit</td>
                                        <td data-label="Đơn giá" class="text-end">
                                            <span class="fw-bold text-success">@((p.Price).ToString("N0")) đ</span>
                                        </td>
                                        <td data-label="Tồn kho" class="text-center">
                                            <span class="fw-bold @(p.CurrentStock <= 0 ? "text-danger" : (p.CurrentStock <= p.MinStockLevel ? "text-warning" : "text-dark"))">
                                                @p.CurrentStock
                                            </span>
                                        </td>
                                        <td data-label="Trạng thái" class="text-center">
                                            <StockStatusBadge CurrentStock="@p.CurrentStock" MinStock="@p.MinStockLevel" />
                                        </td>
                                        <td data-label="Thao tác" class="text-end pe-3">
                                            <div class="d-inline-flex gap-1.5">
                                                <button class="btn btn-xs btn-primary rounded-pill px-2.5 py-1 fw-bold" 
                                                        @onclick="() => OpenLivePreview(p)" title="Xem thử">
                                                    Xem thử
                                                </button>
                                                <button class="btn btn-xs btn-outline-success rounded-pill px-2.5 py-1 fw-bold" 
                                                        @onclick="() => HandleAddToCart(p)" disabled="@(p.CurrentStock <= 0)">
                                                    + Giỏ
                                                </button>
                                                <button class="btn btn-xs btn-outline-dark rounded-pill px-2 py-1 fw-bold" 
                                                        @onclick="() => OpenQrModal(p)" title="Xem mã QR & Tem nhãn SKU">
                                                    <i class="bi bi-qr-code"></i> QR
                                                </button>
                                                <button class="btn btn-xs btn-light border rounded-pill px-2" 
                                                        @onclick="() => OpenEditModal(p)" title="Sửa">
                                                    <i class="bi bi-pencil text-secondary"></i>
                                                </button>
                                                <button class="btn btn-xs btn-light border rounded-pill px-2 text-danger" 
                                                        @onclick="() => OpenDeleteConfirm(p)" title="Xóa">
                                                    <i class="bi bi-trash3 text-danger"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- =========================================================================
     MODAL 1: LIVE PREVIEW ("XEM THỬ" CHUẨN GIAO DIỆN THEMES.SAPO.VN)
     ========================================================================= -->
@if (previewProduct != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.7); backdrop-filter: blur(4px); z-index: 1070;">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <!-- Browser Bar Simulation Header -->
                <div class="modal-header bg-dark text-white py-2.5 px-3 border-0">
                    <div class="d-flex align-items-center gap-2">
                        <span class="rounded-circle bg-danger d-inline-block" style="width: 11px; height: 11px;"></span>
                        <span class="rounded-circle bg-warning d-inline-block" style="width: 11px; height: 11px;"></span>
                        <span class="rounded-circle bg-success d-inline-block" style="width: 11px; height: 11px;"></span>
                        <span class="text-white-50 ms-2 small d-none d-sm-inline">Xem thử: <strong>@previewProduct.Name</strong></span>
                    </div>

                    <!-- Device Switcher Pills (Desktop / Tablet / Mobile) -->
                    <div class="btn-group rounded-pill bg-white bg-opacity-10 p-0.5" role="group">
                        <button type="button" class="btn btn-xs rounded-pill @(previewDevice == "desktop" ? "btn-success text-white fw-bold" : "btn-link text-white-50")"
                                @onclick='() => previewDevice = "desktop"' title="Xem ở chế độ Máy tính">
                            <i class="bi bi-laptop me-1"></i>Desktop
                        </button>
                        <button type="button" class="btn btn-xs rounded-pill @(previewDevice == "tablet" ? "btn-success text-white fw-bold" : "btn-link text-white-50")"
                                @onclick='() => previewDevice = "tablet"' title="Xem ở chế độ Máy tính bảng">
                            <i class="bi bi-tablet me-1"></i>Tablet
                        </button>
                        <button type="button" class="btn btn-xs rounded-pill @(previewDevice == "mobile" ? "btn-success text-white fw-bold" : "btn-link text-white-50")"
                                @onclick='() => previewDevice = "mobile"' title="Xem ở chế độ Điện thoại di động">
                            <i class="bi bi-phone me-1"></i>Mobile
                        </button>
                    </div>

                    <button type="button" class="btn-close btn-close-white" @onclick="CloseLivePreview"></button>
                </div>

                <!-- Preview Body Container -->
                <div class="modal-body p-0 bg-light d-flex justify-content-center overflow-auto" style="min-height: 480px;">
                    <div class="transition-all" style="width: @(previewDevice == "desktop" ? "100%" : (previewDevice == "tablet" ? "768px" : "390px")); background: #ffffff; box-shadow: 0 4px 20px rgba(0,0,0,0.08); min-height: 100%;">
                        <div class="p-4">
                            <!-- Hero inside preview -->
                            <div class="row g-4 align-items-center mb-4">
                                <div class="col-12 col-md-6">
                                    <div class="rounded-4 overflow-hidden border shadow-sm position-relative text-center p-3" style="background: #ffffff;">
                                        <img src="@GetProductImage(previewProduct.ImageUrl)" 
                                             alt="@previewProduct.Name" class="w-100 h-auto" style="max-height: 320px; object-fit: contain;" 
                                             onerror="this.src='images/default-product.svg'" />
                                        <div class="position-absolute top-0 start-0 m-2">
                                            <span class="badge bg-success rounded-pill px-2.5 py-1 fw-bold">
                                                <i class="bi bi-patch-check-fill me-1"></i>Chuẩn SEO 100%
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 col-md-6">
                                    <span class="badge bg-light text-secondary border px-2.5 py-1 rounded-pill fw-semibold mb-2">
                                        @previewProduct.Category
                                    </span>
                                    <h3 class="fw-bold text-dark mb-2">@previewProduct.Name</h3>
                                    
                                    <div class="d-flex align-items-baseline gap-2 mb-3">
                                        <span class="h3 fw-bold text-success mb-0">@((previewProduct.Price).ToString("N0")) đ</span>
                                        @if (previewProduct.OriginalPrice.HasValue)
                                        {
                                            <span class="text-muted text-decoration-line-through">@((previewProduct.OriginalPrice.Value).ToString("N0")) đ</span>
                                        }
                                    </div>

                                    <p class="text-muted mb-3" style="line-height: 1.6;">
                                        @(string.IsNullOrEmpty(previewProduct.Description) ? "Giao diện và mặt hàng chất lượng cao, tối ưu hóa hiển thị trên mọi thiết bị máy tính và di động." : previewProduct.Description)
                                    </p>

                                    <!-- Specs & Stock Info -->
                                    <div class="p-3 bg-light rounded-3 mb-3 border">
                                        <div class="row g-2 small">
                                            <div class="col-6">Mã hàng (SKU): <strong class="text-dark">@previewProduct.Sku</strong></div>
                                            <div class="col-6">Đơn vị tính: <strong class="text-dark">@previewProduct.Unit</strong></div>
                                            <div class="col-6">Tồn kho hiện tại: <strong class="text-success">@previewProduct.CurrentStock @previewProduct.Unit</strong></div>
                                            <div class="col-6">Ngưỡng tối thiểu: <strong class="text-dark">@previewProduct.MinStockLevel</strong></div>
                                        </div>
                                    </div>

                                    <!-- Action Buttons in Preview Modal -->
                                    <div class="d-flex flex-wrap gap-2 pt-2">
                                        <button type="button" class="btn btn-primary rounded-pill px-4 py-2 fw-bold d-flex align-items-center gap-2 shadow-sm"
                                                disabled="@(previewProduct.CurrentStock <= 0)"
                                                @onclick="() => { HandleAddToCart(previewProduct); CloseLivePreview(); }">
                                            <i class="bi bi-cart-plus-fill fs-5"></i>
                                            <span>Thêm Vào Giỏ Hàng</span>
                                        </button>

                                        <button type="button" class="btn btn-warning text-dark rounded-pill px-3.5 py-2 fw-bold d-flex align-items-center gap-2 shadow-sm"
                                                disabled="@(previewProduct.CurrentStock <= 0)"
                                                @onclick="() => { HandleBuyNow(previewProduct); CloseLivePreview(); }">
                                            <i class="bi bi-lightning-charge-fill fs-5"></i>
                                            <span>Bán Ngay Tại Quầy POS</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Footer of Preview Modal -->
                <div class="modal-footer bg-white border-top px-4 py-2.5 d-flex justify-content-between">
                    <span class="small text-muted">
                        <i class="bi bi-info-circle me-1"></i>Trình giả lập chế độ xem: <strong>@(previewDevice.ToUpper())</strong> (Thử responsive 390px, 768px, 1200px)
                    </span>
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" @onclick="CloseLivePreview">
                        Đóng Xem Thử
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- =========================================================================
     MODAL 2: THÊM / CHỈNH SỬA HÀNG HÓA (ĐÁP ỨNG K3.2 EDITFORM & VALIDATION)
     ========================================================================= -->
@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.6); backdrop-filter: blur(3px); z-index: 1070;">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header bg-success text-white py-3 px-4">
                    <h5 class="modal-title fw-bold">
                        <i class="bi @(isEditMode ? "bi-pencil-square" : "bi-plus-circle") me-2"></i>
                        @(isEditMode ? $"Chỉnh Sửa Hàng Hóa: {modalProduct.Name}" : "Thêm Hàng Hóa Mới")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseModal"></button>
                </div>
                
                <EditForm Model="@modalProduct" OnValidSubmit="SaveProduct">
                    <DataAnnotationsValidator />
                    <div class="modal-body p-4">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label small fw-bold">Mã Hàng (SKU) *</label>
                                <InputText class="form-control" @bind-Value="modalProduct.Sku" placeholder="VD: EH-01, TL-01" />
                                <ValidationMessage For="@(() => modalProduct.Sku)" class="text-danger small" />
                            </div>
                            <div class="col-md-8">
                                <label class="form-label small fw-bold">Tên Hàng Hóa *</label>
                                <InputText class="form-control" @bind-Value="modalProduct.Name" placeholder="Tên sản phẩm đầy đủ" />
                                <ValidationMessage For="@(() => modalProduct.Name)" class="text-danger small" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-bold">Đơn Vị Tính (ĐVT) *</label>
                                <InputText class="form-control" @bind-Value="modalProduct.Unit" placeholder="Cái, Thùng, Hộp, Gói..." />
                                <ValidationMessage For="@(() => modalProduct.Unit)" class="text-danger small" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-bold">Nhóm Ngành Hàng *</label>
                                <select class="form-select" @bind="modalProduct.Category">
                                    @foreach (var cat in allCategories.Where(c => c != "Tất cả"))
                                    {
                                        <option value="@cat">@cat</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-bold">Đơn Giá Bán Lẻ (VNĐ) *</label>
                                <InputNumber class="form-control" @bind-Value="modalProduct.Price" />
                                <ValidationMessage For="@(() => modalProduct.Price)" class="text-danger small" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Tồn Kho Ban Đầu</label>
                                <InputNumber class="form-control" @bind-Value="modalProduct.CurrentStock" disabled="@isEditMode" />
                                @if (isEditMode)
                                {
                                    <small class="text-muted">Tồn kho chỉ được thay đổi thông qua duyệt phiếu nhập/xuất.</small>
                                }
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Ngưỡng Tồn Tối Thiểu (Min Stock)</label>
                                <InputNumber class="form-control" @bind-Value="modalProduct.MinStockLevel" />
                            </div>
                            <!-- Image URL input -->
                            <div class="col-12">
                                <label class="form-label small fw-bold">Đường Dẫn Hình Ảnh (Image URL)</label>
                                <InputText class="form-control" @bind-Value="modalProduct.ImageUrl" placeholder="https://images.unsplash.com/..." />
                                <div class="d-flex flex-wrap gap-2 mt-2 align-items-center">
                                    <span class="small text-muted">Chọn ảnh nhanh:</span>
                                    <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill"
                                            @onclick='() => modalProduct.ImageUrl = "images/products/sunlight-chanh.jpg"'>
                                        Rửa chén Sunlight
                                    </button>
                                    <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill"
                                            @onclick='() => modalProduct.ImageUrl = "images/products/simply-1l.jpg"'>
                                        Dầu ăn Simply
                                    </button>
                                    <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill"
                                            @onclick='() => modalProduct.ImageUrl = "images/products/heineken.png"'>
                                        Bia Heineken Silver
                                    </button>
                                    <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill"
                                            @onclick='() => modalProduct.ImageUrl = "images/products/coca-cola.png"'>
                                        Nước ngọt (Coca-Cola)
                                    </button>
                                    <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill"
                                            @onclick='() => modalProduct.ImageUrl = "images/products/swing-steak.jpg"'>
                                        Snack Swing
                                    </button>
                                    <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill"
                                            @onclick='() => modalProduct.ImageUrl = "images/products/ostar-kimchi.jpg"'>
                                        Snack O'Star
                                    </button>
                                    <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill"
                                            @onclick='() => modalProduct.ImageUrl = "images/products/toonies.jpg"'>
                                        Snack Toonies
                                    </button>
                                    <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill"
                                            @onclick='() => modalProduct.ImageUrl = "images/products/sting.jpg"'>
                                        Nước tăng lực Sting
                                    </button>
                                    <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill"
                                            @onclick='() => modalProduct.ImageUrl = "images/products/lays.jpg"'>
                                        Bánh snack (Lay&#39;s)
                                    </button>
                                    <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill"
                                            @onclick='() => modalProduct.ImageUrl = "images/products/vinamilk.jpg"'>
                                        Sữa tươi (Vinamilk)
                                    </button>
                                    <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill"
                                            @onclick='() => modalProduct.ImageUrl = "images/products/haohao.jpg"'>
                                        Mì ăn liền (Hảo Hảo)
                                    </button>
                                    <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill"
                                            @onclick='() => modalProduct.ImageUrl = "images/products/omo.jpg"'>
                                        Bột giặt (Omo)
                                    </button>
                                    <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill"
                                            @onclick='() => modalProduct.ImageUrl = "images/products/chinsu.jpg"'>
                                        Gia vị (Chinsu)
                                    </button>
                                </div>
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-bold">Mô Tả Hàng Hóa</label>
                                <InputTextArea class="form-control" rows="2" @bind-Value="modalProduct.Description" placeholder="Mô tả chi tiết sản phẩm..." />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light border-top px-4 py-2.5">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-3" @onclick="CloseModal">Hủy bỏ</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">
                            <i class="bi bi-check-lg me-1"></i>@(isEditMode ? "Cập Nhật" : "Lưu Hàng Hóa")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<!-- Modal Xác Nhận Xóa bằng Component Tái Sử Dụng ConfirmActionModal (K3.1) -->
<ConfirmActionModal 
    IsVisible="@(productToDelete != null)"
    Title="Xác Nhận Xóa Hàng Hóa"
    Message="@($"Bạn có chắc chắn muốn xóa '{productToDelete?.Name}' (SKU: {productToDelete?.Sku}) khỏi kho?")"
    DetailMessage="Thao tác này sẽ xóa vĩnh viễn sản phẩm khỏi CSDL SQL Server (Tiêu chí K3.1: Component tái sử dụng có EventCallback)."
    ConfirmText="Xóa Vĩnh Viễn"
    CancelText="Hủy Bỏ"
    ConfirmButtonClass="btn-danger"
    OnConfirm="ConfirmDelete"
    OnCancel="@(() => productToDelete = null)" />

<!-- =========================================================================
     MODAL 3: XEM MÃ QR LỚN & TEM NHÃN GIÁ HÀNG HÓA SIÊU THỊ
     ========================================================================= -->
@if (showQrModal && qrProduct != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.7); backdrop-filter: blur(4px); z-index: 1080;">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 480px;">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header bg-dark text-white py-3 px-4 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-qr-code-scan text-success fs-5"></i>
                        <h6 class="modal-title fw-bold mb-0">Mã QR & Tem Nhãn Hàng Hóa</h6>
                    </div>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseQrModal"></button>
                </div>
                
                <div class="modal-body p-4 bg-light text-center">
                    <!-- TEM NHÃN SIÊU THỊ BÁN LẺ (RETAIL PRICE & BARCODE LABEL) -->
                    <div class="bg-white p-3.5 rounded-3 border shadow-xs text-start mx-auto" style="max-width: 360px;">
                        <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-2">
                            <span class="badge bg-success-subtle text-success fw-bold text-uppercase" style="font-size: 0.72rem;">
                                SIÊU THỊ TIỆN LỢI &bull; KHO BÁN LẺ
                            </span>
                            <span class="small text-muted fw-semibold">@qrProduct.Category</span>
                        </div>
                        
                        <h6 class="fw-bold text-dark mb-1" style="font-size: 0.95rem; line-height: 1.35;">
                            @qrProduct.Name
                        </h6>
                        
                        <div class="d-flex justify-content-between align-items-baseline mb-2">
                            <span class="small text-muted">ĐVT: <strong>@qrProduct.Unit</strong> &bull; Tồn: <strong class="text-success">@qrProduct.CurrentStock</strong></span>
                            <div class="h4 fw-bold text-success mb-0">
                                @((qrProduct.Price).ToString("N0")) đ
                            </div>
                        </div>

                        <!-- ẢNH MÃ QR LỚN, RÕ RÀNG, CHUẨN QUIET ZONE 1:1 KHÔNG BỊ CẮT GÓC (260x260px) -->
                        <div class="text-center p-2.5 bg-white rounded-3 border my-2.5 position-relative d-flex justify-content-center align-items-center">
                            <img src="https://api.qrserver.com/v1/create-qr-code/?size=260x260&margin=12&data=@(Uri.EscapeDataString(qrProduct.Sku))" 
                                 alt="Mã QR SKU @qrProduct.Sku"
                                 class="img-fluid"
                                 style="width: 240px; height: 240px; object-fit: contain; image-rendering: pixelated;" />
                        </div>
                        
                        <div class="text-center border-top pt-2">
                            <div class="font-monospace fw-bold fs-6 text-dark tracking-wider mb-0">
                                * @qrProduct.Sku *
                            </div>
                            <small class="text-muted" style="font-size: 0.7rem;">
                                Quét bằng camera hoặc máy quét mã vạch để tự động tra cứu trong hệ thống
                            </small>
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-white border-top px-4 py-2.5 d-flex flex-wrap justify-content-between gap-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" @onclick="CloseQrModal">
                        Đóng
                    </button>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-sm btn-outline-success rounded-pill fw-semibold px-3"
                                @onclick='() => NavigateToPosWithSku(qrProduct.Sku)'>
                            <i class="bi bi-cart-check me-1"></i>Bán tại POS
                        </button>
                        <a href="https://api.qrserver.com/v1/create-qr-code/?size=400x400&margin=20&data=@(Uri.EscapeDataString(qrProduct.Sku))"
                           target="_blank" download="QR_@(qrProduct.Sku).png"
                           class="btn btn-sm btn-outline-primary rounded-pill fw-semibold px-3">
                            <i class="bi bi-download me-1"></i>Tải QR
                        </a>
                        <button type="button" class="btn btn-sm btn-success text-white rounded-pill fw-bold px-3 shadow-xs"
                                @onclick="PrintQrLabel">
                            <i class="bi bi-printer me-1"></i>In Tem Nhãn
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Product> allProducts = new();
    private List<Product> filteredProducts = new();
    private HashSet<int> justAddedIds = new();

    private string viewMode = "grid"; // "grid" hoặc "table"
    private string searchTerm = string.Empty;
    private string selectedCategory = "Tất cả";
    private string priceFilter = "all";
    private string stockFilter = "all";
    private string sortBy = "default";

    // Nhóm ngành hàng bán lẻ siêu thị & tiện lợi (Tự động cập nhật từ CSDL)
    private List<string> allCategories = new()
    {
        "Tất cả",
        "Thực phẩm & Gia vị",
        "Bánh kẹo & Đồ ăn vặt",
        "Hóa mỹ phẩm & Đồ gia dụng",
        "Nước giải khát & Bia",
        "Sữa & Chế phẩm sữa",
        "Cà phê & Trà",
        "Văn phòng phẩm"
    };

    private Product? qrProduct = null;
    private bool showQrModal = false;

    private Product? previewProduct = null;
    private string previewDevice = "desktop"; // "desktop", "tablet", "mobile"

    private bool showModal = false;
    private bool isEditMode = false;
    private Product modalProduct = new();
    private Product? productToDelete = null;

    private string alertMessage = string.Empty;
    private bool isSuccessAlert = false;

    private bool showToast = false;
    private string toastMessage = string.Empty;

    [SupplyParameterFromQuery(Name = "stock")]
    public string? QueryStock { get; set; }

    [SupplyParameterFromQuery(Name = "filter")]
    public string? QueryFilter { get; set; }

    protected override async Task OnInitializedAsync()
    {
        CartService.OnChange += OnCartUpdated;
        await LoadProducts();
    }

    protected override void OnParametersSet()
    {
        string? stockParam = QueryStock ?? QueryFilter;
        if (!string.IsNullOrEmpty(stockParam))
        {
            if (stockParam == "low" || stockParam == "low_stock" || stockParam == "lowstock")
            {
                stockFilter = "low_stock";
            }
            else if (stockParam == "out" || stockParam == "out_of_stock" || stockParam == "outofstock")
            {
                stockFilter = "out_of_stock";
            }
            else if (stockParam == "in" || stockParam == "in_stock")
            {
                stockFilter = "in_stock";
            }
            ApplyFilters();
        }
    }

    private async void OnCartUpdated()
    {
        await InvokeAsync(StateHasChanged);
    }

    private string GetProductImage(string? url)
    {
        if (string.IsNullOrWhiteSpace(url)) return "images/default-product.svg";
        return $"{url}?v=20261021_v4";
    }

    private async Task LoadProducts()
    {
        allProducts = (await SearchProducts.ExecuteAsync()).ToList();
        
        // Cập nhật danh mục động từ CSDL
        var dynamicCats = allProducts.Select(p => p.Category)
                                     .Where(c => !string.IsNullOrWhiteSpace(c))
                                     .Distinct()
                                     .OrderBy(c => c)
                                     .ToList();
        allCategories = new List<string> { "Tất cả" };
        allCategories.AddRange(dynamicCats);

        ApplyFilters();
    }

    private void OpenQrModal(Product product)
    {
        qrProduct = product;
        showQrModal = true;
    }

    private void CloseQrModal()
    {
        showQrModal = false;
        qrProduct = null;
    }

    private void NavigateToPosWithSku(string sku)
    {
        CloseQrModal();
        Nav.NavigateTo($"cart?scan={Uri.EscapeDataString(sku)}");
    }

    private async Task PrintQrLabel()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    private void ApplyFilters()
    {
        var query = allProducts.AsEnumerable();

        // Search term (hỗ trợ tìm kiếm tiếng Việt có dấu và không dấu: vd "hao hao" -> "Mì Hảo Hảo")
        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            query = query.Where(p =>
                KhoBanLe.Services.SearchHelper.Matches(p.Name, searchTerm) ||
                KhoBanLe.Services.SearchHelper.Matches(p.Sku, searchTerm) ||
                KhoBanLe.Services.SearchHelper.Matches(p.Category, searchTerm));
        }

        // Category
        if (selectedCategory != "Tất cả")
        {
            query = query.Where(p => p.Category.Equals(selectedCategory, StringComparison.OrdinalIgnoreCase));
        }

        // Price range
        query = priceFilter switch
        {
            "under_20k" => query.Where(p => p.Price < 20000),
            "20k_50k" => query.Where(p => p.Price >= 20000 && p.Price <= 50000),
            "50k_100k" => query.Where(p => p.Price > 50000 && p.Price <= 100000),
            "above_100k" => query.Where(p => p.Price > 100000),
            _ => query
        };

        // Stock status
        if (stockFilter == "in_stock")
        {
            query = query.Where(p => p.CurrentStock > p.MinStockLevel);
        }
        else if (stockFilter == "low_stock")
        {
            query = query.Where(p => p.CurrentStock > 0 && p.CurrentStock <= p.MinStockLevel);
        }
        else if (stockFilter == "out_of_stock")
        {
            query = query.Where(p => p.CurrentStock <= 0);
        }

        // Sorting
        query = sortBy switch
        {
            "price_asc" => query.OrderBy(p => p.Price),
            "price_desc" => query.OrderByDescending(p => p.Price),
            "stock_desc" => query.OrderByDescending(p => p.CurrentStock),
            "id_desc" => query.OrderByDescending(p => p.Id),
            _ => query.OrderBy(p => p.Id)
        };

        filteredProducts = query.ToList();
    }

    private void FilterByCategory(string cat)
    {
        selectedCategory = cat;
        ApplyFilters();
    }

    private void FilterByPriceRange(string range)
    {
        priceFilter = range;
        ApplyFilters();
    }

    private void FilterByStock(string filter)
    {
        stockFilter = filter;
        ApplyFilters();
    }

    private void TogglePriceSort()
    {
        if (sortBy == "price_asc")
        {
            sortBy = "price_desc";
        }
        else
        {
            sortBy = "price_asc";
        }
        ApplyFilters();
    }

    private void ToggleUnder1Million()
    {
        if (priceFilter == "under_1m")
        {
            priceFilter = "all";
        }
        else
        {
            priceFilter = "under_1m";
        }
        ApplyFilters();
    }

    private void SetSort(string sort)
    {
        if (sortBy == sort)
        {
            sortBy = "default";
        }
        else
        {
            sortBy = sort;
        }
        ApplyFilters();
    }

    private void ClearSearch()
    {
        searchTerm = string.Empty;
        stockFilter = "all";
        priceFilter = "all";
        selectedCategory = "Tất cả";
        sortBy = "default";
        ApplyFilters();
    }

    private void SetQuickSearch(string term)
    {
        searchTerm = term;
        ApplyFilters();
    }

    private string GetCategoryIcon(string cat) => cat switch
    {
        "Tất cả" => "bi-grid-fill",
        "Thực phẩm & Gia vị" => "bi-egg-fried",
        "Bánh kẹo & Đồ ăn vặt" => "bi-cookie",
        "Hóa mỹ phẩm & Đồ gia dụng" => "bi-stars",
        "Nước giải khát & Bia" => "bi-cup-straw",
        "Sữa & Chế phẩm sữa" => "bi-droplet-half",
        "Cà phê & Trà" => "bi-cup-hot-fill",
        "Văn phòng phẩm" => "bi-pen-fill",
        _ => "bi-tag-fill"
    };

    // MODAL XEM THỬ (LIVE PREVIEW)
    private void OpenLivePreview(Product p)
    {
        previewProduct = p;
        previewDevice = "desktop";
    }

    private void CloseLivePreview()
    {
        previewProduct = null;
    }

    // THAO TÁC GIỎ HÀNG & MUA BÁN
    private void HandleAddToCart(Product p)
    {
        var err = CartService.AddToCart(p, 1, autoOpenDrawer: false);
        if (!string.IsNullOrEmpty(err))
        {
            alertMessage = err;
            isSuccessAlert = false;
        }
        else
        {
            toastMessage = $"Đã thêm 1 {p.Unit} '{p.Name}' vào giỏ hàng!";
            showToast = true;
            alertMessage = string.Empty;

            justAddedIds.Add(p.Id);
            StateHasChanged();

            _ = Task.Run(async () =>
            {
                await Task.Delay(2000);
                justAddedIds.Remove(p.Id);
                await InvokeAsync(StateHasChanged);
            });
        }
    }

    private void HandleBuyNow(Product p)
    {
        var err = CartService.AddToCart(p, 1, autoOpenDrawer: true);
        if (!string.IsNullOrEmpty(err))
        {
            alertMessage = err;
            isSuccessAlert = false;
        }
        else
        {
            alertMessage = string.Empty;
        }
    }

    // THAO TÁC XÓA (K3.1)
    private void OpenDeleteConfirm(Product p)
    {
        productToDelete = p;
    }

    private async Task ConfirmDelete()
    {
        if (!RoleService.IsManager)
        {
            alertMessage = "Chỉ Quản lý kho mới có quyền xóa hàng hóa khỏi hệ thống!";
            isSuccessAlert = false;
            productToDelete = null;
            return;
        }

        if (productToDelete != null)
        {
            await DeleteProduct.ExecuteAsync(productToDelete.Id);
            alertMessage = $"Đã xóa sản phẩm '{productToDelete.Name}' thành công khỏi kho!";
            isSuccessAlert = true;
            productToDelete = null;
            await LoadProducts();
        }
    }

    // MODAL THÊM / SỬA (K3.2)
    private void OpenAddModal()
    {
        isEditMode = false;
        modalProduct = new Product
        {
            Sku = $"BL-{(allProducts.Count + 1):D3}",
            Unit = "Lon",
            Category = "Nước giải khát & Bia",
            Price = 15000,
            CurrentStock = 50,
            MinStockLevel = 15,
            ImageUrl = "https://images.unsplash.com/photo-1554866585-cd94860890b7?w=400"
        };
        showModal = true;
    }

    private void OpenEditModal(Product p)
    {
        isEditMode = true;
        modalProduct = new Product
        {
            Id = p.Id,
            Sku = p.Sku,
            Name = p.Name,
            Unit = p.Unit,
            Category = p.Category,
            Price = p.Price,
            CurrentStock = p.CurrentStock,
            MinStockLevel = p.MinStockLevel,
            Description = p.Description,
            ImageUrl = p.ImageUrl
        };
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
    }

    private async Task SaveProduct()
    {
        if (isEditMode)
        {
            await EditProduct.ExecuteAsync(modalProduct);
            alertMessage = $"Đã cập nhật thông tin sản phẩm '{modalProduct.Name}'!";
        }
        else
        {
            await AddProduct.ExecuteAsync(modalProduct);
            alertMessage = $"Đã thêm mới sản phẩm '{modalProduct.Name}' vào kho!";
        }
        isSuccessAlert = true;
        showModal = false;
        await LoadProducts();
    }

    private async Task ExportToExcel()
    {
        await ExcelService.ExportProductListToExcelAsync(filteredProducts);
    }

    public void Dispose()
    {
        CartService.OnChange -= OnCartUpdated;
    }
}
