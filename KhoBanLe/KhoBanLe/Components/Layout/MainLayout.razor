@inherits LayoutComponentBase
@namespace KhoBanLe.Components.Layout
@inject UserRoleService RoleService
@inject ShoppingCartService CartService
@inject NavigationManager Nav
@implements IDisposable

<div class="admin-wrapper @(isSidebarCollapsed ? "sidebar-collapsed" : "")">
    <!-- 1. LEFT ADMIN SIDEBAR -->
    <aside class="admin-sidebar @(isMobileMenuOpen ? "mobile-open" : "")">
        <NavMenu IsCollapsed="@isSidebarCollapsed" OnCloseMobile="() => isMobileMenuOpen = false" />
    </aside>

    <!-- Mobile Sidebar Backdrop Overlay -->
    @if (isMobileMenuOpen)
    {
        <div class="mobile-sidebar-backdrop d-xl-none" @onclick="() => isMobileMenuOpen = false"></div>
    }

    <!-- 2. MAIN APPLICATION CONTENT WRAPPER -->
    <div class="admin-main">
        <!-- TOP APP HEADER -->
        <header class="admin-topbar">
            <div class="container-fluid px-3 px-xl-4 py-2.5">
                <div class="d-flex align-items-center justify-content-between gap-3">
                    <!-- Left: Hamburger Toggle & Breadcrumb Title -->
                    <div class="d-flex align-items-center gap-2.5">
                        <!-- Desktop Sidebar Collapse Toggle -->
                        <button type="button" class="btn btn-sm btn-light border rounded-3 p-2 d-none d-xl-inline-flex" 
                                @onclick="ToggleSidebarCollapse" title="Thu gọn / Mở rộng Sidebar">
                            <i class="bi @(isSidebarCollapsed ? "bi-layout-sidebar" : "bi-layout-sidebar-inset") fs-5 text-secondary"></i>
                        </button>

                        <!-- Mobile Hamburger Button -->
                        <button type="button" class="btn btn-sm btn-light border rounded-3 p-2 d-xl-none" 
                                @onclick="() => isMobileMenuOpen = !isMobileMenuOpen" title="Mở menu điều hướng">
                            <i class="bi bi-list fs-5 text-dark"></i>
                        </button>

                        <!-- System Title / Sub-header -->
                        <div class="d-none d-sm-block">
                            <div class="fw-bold text-dark fs-6 lh-sm">Hệ Thống Kho Bán Lẻ</div>
                            <small class="text-muted" style="font-size: 0.75rem;">Nhập – Xuất – Tồn & Bán Hàng Tại Quầy (POS)</small>
                        </div>
                    </div>

                    <!-- Right Toolbar: Actions, Role Switcher, Cart & Profile -->
                    <div class="d-flex align-items-center gap-2">
                        <!-- Quick Transaction Buttons -->
                        <div class="d-none d-md-flex align-items-center gap-1.5">
                            <a href="receipts/create" class="btn btn-sm btn-outline-success rounded-pill px-3 py-1 fw-semibold d-flex align-items-center gap-1" title="Tạo phiếu nhập mới">
                                <i class="bi bi-plus-lg"></i>
                                <span>Nhập kho</span>
                            </a>
                            <a href="issues/create" class="btn btn-sm btn-outline-danger rounded-pill px-3 py-1 fw-semibold d-flex align-items-center gap-1" title="Tạo phiếu xuất mới">
                                <i class="bi bi-dash-lg"></i>
                                <span>Xuất kho</span>
                            </a>
                        </div>

                        <!-- Role Switcher Pill -->
                        <div class="d-flex align-items-center gap-1 bg-light p-1 rounded-pill border">
                            <button type="button" 
                                    class="btn btn-xs py-1 px-2.5 rounded-pill fw-bold @(RoleService.CurrentRole == SystemRole.WarehouseStaff ? "btn-primary text-white" : "btn-light text-secondary")"
                                    @onclick="() => RoleService.SetRole(SystemRole.WarehouseStaff)" style="font-size: 0.78rem;">
                                Thủ kho
                            </button>
                            <button type="button" 
                                    class="btn btn-xs py-1 px-2.5 rounded-pill fw-bold @(RoleService.CurrentRole == SystemRole.InventoryManager ? "btn-warning text-dark" : "btn-light text-secondary")"
                                    @onclick="() => RoleService.SetRole(SystemRole.InventoryManager)" style="font-size: 0.78rem;">
                                Quản lý
                            </button>
                        </div>

                        <!-- Quick Cart Button -->
                        <button type="button" class="btn btn-sm btn-outline-success rounded-pill fw-bold position-relative px-3 py-1.5 shadow-xs d-flex align-items-center gap-1.5"
                                @onclick="CartService.ToggleDrawer" title="Xem giỏ hàng & Bán lẻ POS">
                            <i class="bi bi-cart3 fs-6"></i>
                            <span class="d-none d-lg-inline">Giỏ POS</span>
                            @if (CartService.TotalItems > 0)
                            {
                                <span class="badge rounded-pill bg-danger text-white ms-1">
                                    @CartService.TotalItems
                                </span>
                            }
                        </button>

                        <!-- User Profile Avatar Badge -->
                        <div class="d-flex align-items-center gap-2 border-start ps-2.5 ms-1">
                            <div class="rounded-circle @(RoleService.CurrentRole == SystemRole.WarehouseStaff ? "bg-primary bg-opacity-15 text-primary border-primary" : "bg-warning bg-opacity-20 text-warning-emphasis border-warning") d-flex align-items-center justify-content-center fw-bold" 
                                 style="width: 36px; height: 36px; font-size: 0.85rem; border: 1.5px solid;">
                                @(RoleService.CurrentRole == SystemRole.WarehouseStaff ? "TK" : "QL")
                            </div>
                            <div class="d-none d-lg-block text-start lh-sm">
                                <div class="fw-bold text-dark small">@RoleService.CurrentUserName</div>
                                <small class="text-success fw-medium" style="font-size: 0.72rem;">@RoleService.RoleDisplayName</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <!-- PAGE CONTENT BODY -->
        <main class="admin-content flex-grow-1 p-3 p-xl-4">
            @Body
        </main>

        <!-- CLEAN MODERN FOOTER -->
        <footer class="bg-white border-top py-3 text-center text-muted small mt-auto">
            <div class="container-fluid px-4 d-flex flex-wrap align-items-center justify-content-between gap-2">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle px-2.5 py-1 rounded-pill fw-semibold">
                        <i class="bi bi-check-circle-fill me-1"></i>Kho Bán Lẻ & POS Thông Minh
                    </span>
                    <span>© 2026 Đồ Án Capstone ECO2415 — Đề tài 13: Kho Bán Lẻ (Nhập – Xuất – Tồn)</span>
                </div>
                <div class="text-muted d-flex align-items-center gap-3">
                    <span>Clean Architecture 4 Tầng &bull; SQL Server Dapper</span>
                    <a href="guide" class="text-decoration-none text-primary fw-semibold">Phiếu Chấm Đồ Án &rarr;</a>
                </div>
            </div>
        </footer>
    </div>
</div>

<!-- Global Quick Cart Drawer -->
<CartDrawer />

<div id="blazor-error-ui">
    Đã xảy ra lỗi không mong muốn. Vui lòng thử tải lại trang.
    <a href="" class="reload fw-semibold text-success">Tải lại</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private bool isSidebarCollapsed = false;
    private bool isMobileMenuOpen = false;

    protected override void OnInitialized()
    {
        CartService.OnChange += OnStateUpdated;
        RoleService.OnRoleChanged += OnStateUpdated;
    }

    private void ToggleSidebarCollapse()
    {
        isSidebarCollapsed = !isSidebarCollapsed;
    }

    private async void OnStateUpdated()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        CartService.OnChange -= OnStateUpdated;
        RoleService.OnRoleChanged -= OnStateUpdated;
    }
}
